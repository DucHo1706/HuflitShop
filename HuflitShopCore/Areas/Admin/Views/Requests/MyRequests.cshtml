@model IEnumerable<HuflitShopCore.Models.StaffRequest>
@{
    ViewData["Title"] = "Đơn từ & Yêu cầu của tôi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Lịch sử Đơn từ & Yêu cầu</h1>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Tạo đơn mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách đơn đã gửi</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Ngày gửi</th>
                            <th>Loại đơn</th>
                            <th>Ca áp dụng</th>
                            <th>Lý do</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú của Quản lý</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.RequestType == "Leave")
                                        {
                                            <span class="badge badge-warning">Xin nghỉ phép</span>
                                        }
                                        else if (item.RequestType == "ForgotCheckIn")
                                        {
                                            <span class="badge badge-info">Quên Check-in</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">@item.RequestType</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.WorkSchedule != null)
                                        {
                                            <strong>@item.WorkSchedule.WorkDate.ToString("dd/MM/yyyy")</strong><br/>
                                            <small class="text-muted">@item.WorkSchedule.Shift.Name (@item.WorkSchedule.Shift.StartTime.ToString(@"hh\:mm") - @item.WorkSchedule.Shift.EndTime.ToString(@"hh\:mm"))</small>
                                        }
                                    </td>
                                    <td>@item.Reason</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="text-warning font-weight-bold"><i class="fas fa-clock"></i> Đang chờ</span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="text-success font-weight-bold"><i class="fas fa-check-circle"></i> Đã duyệt</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="text-danger font-weight-bold"><i class="fas fa-times-circle"></i> Bị từ chối</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.AdminNote))
                                        {
                                            <span class="text-muted">@item.AdminNote</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Bạn chưa gửi đơn từ nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
