@model IEnumerable<HuflitShopCore.Models.StaffRequest>
@{
    ViewData["Title"] = "Quản lý Đơn từ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Đơn từ Nhân viên</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success font-weight-bold shadow-sm">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger font-weight-bold shadow-sm">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách Đơn chờ xử lý</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Nhân viên</th>
                            <th>Ngày gửi</th>
                            <th>Loại đơn</th>
                            <th>Ca áp dụng</th>
                            <th>Lý do của Nhân viên</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Staff.FullName</strong><br/>
                                        <small class="text-muted">@item.Staff.UserName</small>
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.RequestType == "Leave")
                                        {
                                            <span class="badge badge-warning">Xin nghỉ phép</span>
                                        }
                                        else if (item.RequestType == "ForgotCheckIn")
                                        {
                                            <span class="badge badge-info">Quên Check-in</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">@item.RequestType</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.WorkSchedule != null)
                                        {
                                            <strong>@item.WorkSchedule.WorkDate.ToString("dd/MM/yyyy")</strong><br/>
                                            <small class="text-muted">@item.WorkSchedule.Shift.Name (@item.WorkSchedule.Shift.StartTime.ToString(@"hh\:mm") - @item.WorkSchedule.Shift.EndTime.ToString(@"hh\:mm"))</small>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Ca này đã bị hủy.</span>
                                        }
                                    </td>
                                    <td>@item.Reason</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="text-warning font-weight-bold"><i class="fas fa-clock"></i> Đang chờ</span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="text-success font-weight-bold"><i class="fas fa-check-circle"></i> Đã duyệt</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="text-danger font-weight-bold"><i class="fas fa-times-circle"></i> Từ chối</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.AdminNote))
                                        {
                                            <div class="mt-1 small text-muted"><strong>Ghi chú:</strong> @item.AdminNote</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == "Pending")
                                        {
                                            <button type="button" class="btn btn-sm btn-success shadow-sm mb-1" data-toggle="modal" data-target="#processModal-@item.Id" data-action="Approve" title="Duyệt đơn">
                                                <i class="fas fa-check"></i> Duyệt
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger shadow-sm mb-1" data-toggle="modal" data-target="#processModal-@item.Id" data-action="Reject" title="Từ chối">
                                                <i class="fas fa-times"></i> Từ chối
                                            </button>

                                            <!-- Modal Xử lý -->
                                            <div class="modal fade" id="processModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                                <div class="modal-dialog" role="document">
                                                    <div class="modal-content">
                                                        <form asp-action="ProcessRequest" method="post">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title font-weight-bold text-primary">Xử lý Đơn từ</h5>
                                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                    <span aria-hidden="true">&times;</span>
                                                                </button>
                                                            </div>
                                                            <div class="modal-body text-left">
                                                                <input type="hidden" name="requestId" value="@item.Id" />
                                                                <input type="hidden" name="actionType" id="actionType-@item.Id" value="" />
                                                                
                                                                <div class="alert alert-info">
                                                                    Bạn đang thao tác với đơn: <strong>@(item.RequestType == "Leave" ? "Xin nghỉ phép" : "Quên Check-in")</strong> của <strong>@item.Staff.FullName</strong>.
                                                                </div>

                                                                <div class="form-group mt-3">
                                                                    <label class="font-weight-bold">Ghi chú / Phản hồi (Tùy chọn)</label>
                                                                    <textarea name="adminNote" class="form-control" rows="3" placeholder="Nhập ghi chú phản hồi cho nhân viên (nếu có)..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-primary" id="submitBtn-@item.Id">Xác nhận</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>


                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Không có đơn từ nào đang chờ xử lý.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.modal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var action = button.data('action');
                var modal = $(this);
                
                modal.find('input[name="actionType"]').val(action);
                
                var btnSubmit = modal.find('button[type="submit"]');
                if(action === 'Approve') {
                    btnSubmit.removeClass('btn-danger').addClass('btn-success');
                    btnSubmit.html('<i class="fas fa-check"></i> Xác nhận Duyệt');
                } else {
                    btnSubmit.removeClass('btn-success').addClass('btn-danger');
                    btnSubmit.html('<i class="fas fa-times"></i> Xác nhận Từ chối');
                }
            });
        });
    </script>
}
