@model IEnumerable<HuflitShopCore.Models.StaffRequest>
@{
    ViewData["Title"] = "Quản lý Đơn từ Nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    /* Card Premium Styling */
    .request-card {
        border: 1px solid var(--admin-border, #e2e8f0);
        border-radius: 0.75rem;
        background: #ffffff;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

    /* Badge Soft Styles */
    .badge-soft-warning {
        background-color: #fffbeb;
        color: #d97706;
        border: 1px solid #fef3c7;
        font-weight: 600;
    }

    .badge-soft-info {
        background-color: #f0f9ff;
        color: #0284c7;
        border: 1px solid #e0f2fe;
        font-weight: 600;
    }

    .badge-soft-success {
        background-color: #ecfdf5;
        color: #059669;
        border: 1px solid #d1fae5;
        font-weight: 600;
    }

    .badge-soft-danger {
        background-color: #fef2f2;
        color: #dc2626;
        border: 1px solid #fee2e2;
        font-weight: 600;
    }

    /* Action Button Group Alignment */
    .action-btn-group {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        white-space: nowrap !important;
    }

    .btn-action-custom {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0.35rem 0.75rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        border-radius: 0.375rem !important;
        line-height: 1.2 !important;
        transition: all 0.2s ease;
    }

        .btn-action-custom:hover {
            transform: translateY(-1px);
        }

    .nowrap-cell {
        white-space: nowrap !important;
    }

    /* Fix triệt để vỡ footer Modal */
    .modal-footer-custom {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;
        gap: 10px !important;
        padding: 1rem 1.5rem !important;
        background-color: #f8fafc !important;
        border-top: 1px solid #e2e8f0 !important;
    }

        .modal-footer-custom .btn-modal-cancel {
            background-color: #ffffff !important;
            color: #475569 !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.5rem !important;
            padding: 0.4rem 1.25rem !important;
            font-weight: 600 !important;
            font-size: 0.875rem !important;
            height: 38px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer;
        }

        .modal-footer-custom .btn-modal-submit {
            border-radius: 0.5rem !important;
            padding: 0.4rem 1.25rem !important;
            font-weight: 600 !important;
            font-size: 0.875rem !important;
            height: 38px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            white-space: nowrap !important;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
        }
</style>

<div class="container-fluid py-2">
    <!-- Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-dark font-weight-bold" style="letter-spacing: -0.5px;">
                <i class="fas fa-tasks text-primary mr-2"></i>Quản Lý Đơn Từ Nhân Viên
            </h1>
            <p class="text-muted small mb-0">Phê duyệt hoặc từ chối các yêu cầu xin nghỉ phép / quên Check-in</p>
        </div>
        <a asp-action="History" class="btn btn-sm btn-light border text-secondary font-weight-bold px-3 py-2" style="border-radius: 0.5rem;">
            <i class="fas fa-history mr-1"></i> Xem Lịch Sử Đã Xử Lý
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success font-weight-bold shadow-sm border-0 mb-4" style="border-radius: 0.5rem;">
            <i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger font-weight-bold shadow-sm border-0 mb-4" style="border-radius: 0.5rem;">
            <i class="fas fa-exclamation-triangle mr-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Main Table Card -->
    <div class="card request-card mb-4">
        <div class="card-header bg-transparent py-3 border-bottom">
            <h6 class="m-0 font-weight-bold text-dark">
                <i class="fas fa-hourglass-half text-warning mr-1"></i> Danh Sách Đơn Đang Chờ Xử Lý
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-dark" width="100%" cellspacing="0">
                    <thead class="bg-light text-muted small text-uppercase font-weight-bold">
                        <tr>
                            <th class="pl-4 py-3 border-0">Nhân viên</th>
                            <th class="py-3 border-0 nowrap-cell">Ngày gửi</th>
                            <th class="py-3 border-0 nowrap-cell">Loại đơn</th>
                            <th class="py-3 border-0 nowrap-cell">Ca làm áp dụng</th>
                            <th class="py-3 border-0">Lý do của Nhân viên</th>
                            <th class="py-3 border-0 nowrap-cell">Trạng thái</th>
                            <th class="text-center py-3 pr-4 border-0 nowrap-cell">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Nhân viên -->
                                    <td class="pl-4 align-middle">
                                        <strong class="text-dark d-block" style="font-size: 0.92rem;">@item.Staff.FullName</strong>
                                        <small class="text-muted">@@@item.Staff.UserName</small>
                                    </td>

                                    <!-- Ngày gửi -->
                                    <td class="align-middle small text-muted font-weight-bold nowrap-cell">
                                        @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- Loại đơn -->
                                    <td class="align-middle nowrap-cell">
                                        @if (item.RequestType == "Leave")
                                        {
                                            <span class="badge badge-soft-warning px-2.5 py-1.5 rounded-pill">Xin nghỉ phép</span>
                                        }
                                        else if (item.RequestType == "ForgotCheckIn")
                                        {
                                            <span class="badge badge-soft-info px-2.5 py-1.5 rounded-pill">Quên Check-in</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light border px-2.5 py-1.5 rounded-pill">@item.RequestType</span>
                                        }
                                    </td>

                                    <!-- Ca làm áp dụng -->
                                    <td class="align-middle nowrap-cell">
                                        @if (item.WorkSchedule != null)
                                        {
                                            <strong class="text-dark font-weight-bold">@item.WorkSchedule.WorkDate.ToString("dd/MM/yyyy")</strong>
                                            <br />
                                            <small class="text-muted font-weight-bold">@item.WorkSchedule.Shift.Name (@item.WorkSchedule.Shift.StartTime.ToString(@"hh\:mm") - @item.WorkSchedule.Shift.EndTime.ToString(@"hh\:mm"))</small>
                                        }
                                        else
                                        {
                                            <span class="text-danger small font-weight-bold">Ca làm đã bị hủy.</span>
                                        }
                                    </td>

                                    <!-- Lý do -->
                                    <td class="align-middle text-dark font-weight-bold" style="max-width: 250px;">
                                        @item.Reason
                                    </td>

                                    <!-- Trạng thái -->
                                    <td class="align-middle nowrap-cell">
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge badge-soft-warning px-2.5 py-1.5 rounded-pill">
                                                <i class="fas fa-spinner fa-spin mr-1"></i>Đang chờ
                                            </span>
                                        }
                                    </td>

                                    <!-- Hành động & Modal -->
                                    <td class="text-center align-middle pr-4 nowrap-cell">
                                        @if (item.Status == "Pending")
                                        {
                                            <div class="action-btn-group">
                                                <button type="button" class="btn btn-success btn-action-custom shadow-sm" data-toggle="modal" data-target="#processModal-@item.Id" data-action="Approve" title="Duyệt đơn này">
                                                    <i class="fas fa-check mr-1"></i> Duyệt
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-action-custom" data-toggle="modal" data-target="#processModal-@item.Id" data-action="Reject" title="Từ chối đơn này">
                                                    <i class="fas fa-times mr-1"></i> Từ chối
                                                </button>
                                            </div>

                                            <!-- Modal Xử lý Duyệt / Từ chối -->
                                            <div class="modal fade" id="processModal-@item.Id" tabindex="-1" role="dialog" aria-labelledby="processModalLabel-@item.Id" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 500px;">
                                                    <div class="modal-content border-0 shadow-lg" style="border-radius: 0.875rem; overflow: hidden; background: #ffffff;">

                                                        <!-- Modal Header -->
                                                        <div class="modal-header py-3 px-4 border-0" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
                                                            <h5 class="modal-title font-weight-bold d-flex align-items-center" style="font-size: 1.05rem;" id="processModalLabel-@item.Id">
                                                                <i class="fas fa-sliders-h mr-2" style="color: #06b6d4;"></i> Phê Duyệt Đơn Từ Nhân Sự
                                                            </h5>
                                                            <button type="button" class="close text-white opacity-75" data-dismiss="modal" aria-label="Close" style="outline: none;">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>

                                                        <form asp-action="ProcessRequest" method="post" class="m-0 p-0">
                                                            <!-- Modal Body -->
                                                            <div class="modal-body p-4 text-left">
                                                                <input type="hidden" name="requestId" value="@item.Id" />
                                                                <input type="hidden" name="actionType" id="actionType-@item.Id" value="" />

                                                                <!-- Card tóm tắt đơn -->
                                                                <div class="p-3 mb-3 rounded-lg border" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
                                                                    <div class="d-flex align-items-center mb-1">
                                                                        <i class="fas fa-user-circle text-primary mr-2" style="font-size: 1.1rem;"></i>
                                                                        <span class="text-dark font-weight-bold" style="font-size: 0.95rem;">@item.Staff.FullName</span>
                                                                        <small class="text-muted ml-1">(@item.Staff.UserName)</small>
                                                                    </div>
                                                                    <div class="small text-secondary pl-4">
                                                                        Đơn: <strong class="text-dark">@(item.RequestType == "Leave" ? "Xin nghỉ phép" : "Quên Check-in")</strong>
                                                                        @if (item.WorkSchedule != null)
                                                                        {
                                                                            <span> • Ca ngày: <strong class="text-dark">@item.WorkSchedule.WorkDate.ToString("dd/MM/yyyy")</strong></span>
                                                                        }
                                                                    </div>
                                                                </div>

                                                                <!-- Ghi chú phản hồi -->
                                                                <div class="form-group mb-0">
                                                                    <label class="font-weight-bold text-dark small text-uppercase mb-1" style="letter-spacing: 0.3px;">
                                                                        Ghi chú phản hồi <span class="text-muted font-weight-normal">(Không bắt buộc)</span>
                                                                    </label>
                                                                    <textarea name="adminNote"
                                                                              class="form-control p-2.5"
                                                                              rows="3"
                                                                              placeholder="Nhập ghi chú phản hồi cho nhân viên..."
                                                                              style="border-radius: 0.5rem; border: 1px solid #cbd5e1; font-size: 0.875rem; resize: none;"></textarea>
                                                                </div>
                                                            </div>

                                                            <!-- Modal Footer (Custom class không bị vỡ) -->
                                                            <div class="modal-footer-custom">
                                                                <button type="button"
                                                                        class="btn-modal-cancel"
                                                                        data-dismiss="modal">
                                                                    Hủy
                                                                </button>
                                                                <button type="submit"
                                                                        class="btn btn-success btn-modal-submit"
                                                                        id="submitBtn-@item.Id">
                                                                    <i class="fas fa-check mr-2"></i><span>Xác Nhận</span>
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted font-italic">Không có đơn từ nào đang chờ xử lý.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.modal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var action = button.data('action');
                var modal = $(this);

                modal.find('form')[0].reset();
                modal.find('input[name="actionType"]').val(action);

                var btnSubmit = modal.find('button[type="submit"]');
                var modalTitle = modal.find('.modal-title');

                if (action === 'Approve') {
                    btnSubmit.removeClass('btn-danger').addClass('btn-success');
                    btnSubmit.html('<i class="fas fa-check mr-2"></i><span>Xác Nhận Duyệt</span>');
                    modalTitle.html('<i class="fas fa-check-circle text-success mr-2"></i> Duyệt Yêu Cầu');
                } else {
                    btnSubmit.removeClass('btn-success').addClass('btn-danger');
                    btnSubmit.html('<i class="fas fa-times mr-2"></i><span>Xác Nhận Từ Chối</span>');
                    modalTitle.html('<i class="fas fa-times-circle text-danger mr-2"></i> Từ Chối Yêu Cầu');
                }
            });

            $('.modal form').on('submit', function () {
                var btnSubmit = $(this).find('button[type="submit"]');
                btnSubmit.prop('disabled', true);
                btnSubmit.html('<i class="fas fa-spinner fa-spin mr-2"></i><span>Đang xử lý...</span>');
            });
        });
    </script>
}