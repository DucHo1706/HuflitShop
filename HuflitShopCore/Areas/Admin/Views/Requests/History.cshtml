@model IEnumerable<HuflitShopCore.Models.StaffRequest>
@{
    ViewData["Title"] = "Lịch sử Đơn từ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .request-card {
        border: 1px solid var(--admin-border, #e2e8f0);
        border-radius: 0.75rem;
        background: #ffffff;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

    .badge-soft-warning { background-color: #fffbeb; color: #d97706; border: 1px solid #fef3c7; font-weight: 600; }
    .badge-soft-info { background-color: #f0f9ff; color: #0284c7; border: 1px solid #e0f2fe; font-weight: 600; }
    .badge-soft-success { background-color: #ecfdf5; color: #059669; border: 1px solid #d1fae5; font-weight: 600; }
    .badge-soft-danger { background-color: #fef2f2; color: #dc2626; border: 1px solid #fee2e2; font-weight: 600; }
</style>

<div class="container-fluid py-2">
    <!-- Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-dark font-weight-bold" style="letter-spacing: -0.5px;">
                <i class="fas fa-history text-primary mr-2"></i>Lịch Sử Xử Lý Đơn Từ
            </h1>
            <p class="text-muted small mb-0">Danh sách các đơn từ nhân viên đã được phê duyệt hoặc từ chối</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-primary shadow-sm font-weight-bold px-3 py-2" style="border-radius: 0.5rem;">
            <i class="fas fa-clock mr-1"></i> Xem Đơn Chờ Xử Lý
        </a>
    </div>

    <div class="card request-card mb-4">
        <div class="card-header bg-transparent py-3 border-bottom">
            <h6 class="m-0 font-weight-bold text-dark">
                <i class="fas fa-check-double text-primary mr-1"></i> Danh Sách Đơn Từ Đã Phê Duyệt
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-dark" width="100%" cellspacing="0">
                    <thead class="bg-light text-muted small text-uppercase font-weight-bold">
                        <tr>
                            <th class="pl-4 py-3 border-0">Nhân viên</th>
                            <th class="py-3 border-0">Ngày gửi</th>
                            <th class="py-3 border-0">Loại đơn</th>
                            <th class="py-3 border-0">Ca làm áp dụng</th>
                            <th class="py-3 border-0">Lý do từ Nhân viên</th>
                            <th class="py-3 pr-4 border-0">Trạng thái & Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="pl-4 align-middle">
                                        <strong class="text-dark d-block" style="font-size: 0.92rem;">@item.Staff.FullName</strong>
                                        <small class="text-muted">@@@item.Staff.UserName</small>
                                    </td>
                                    <td class="align-middle small text-muted font-weight-bold">
                                        @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="align-middle">
                                        @if (item.RequestType == "Leave")
                                        {
                                            <span class="badge badge-soft-warning px-2.5 py-1.5 rounded-pill">Xin nghỉ phép</span>
                                        }
                                        else if (item.RequestType == "ForgotCheckIn")
                                        {
                                            <span class="badge badge-soft-info px-2.5 py-1.5 rounded-pill">Quên Check-in</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light border px-2.5 py-1.5 rounded-pill">@item.RequestType</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        @if (item.WorkSchedule != null)
                                        {
                                            <strong class="text-dark font-weight-bold">@item.WorkSchedule.WorkDate.ToString("dd/MM/yyyy")</strong>

                                            <br />
                                            <small class="text-muted font-weight-bold">@item.WorkSchedule.Shift.Name (@item.WorkSchedule.Shift.StartTime.ToString(@"hh\:mm") - @item.WorkSchedule.Shift.EndTime.ToString(@"hh\:mm"))</small>
                                        }
                                        else
                                        {
                                            <span class="text-danger small font-weight-bold"><i class="fas fa-exclamation-circle mr-1"></i>Ca làm đã bị hủy.</span>
                                        }
                                    </td>
                                    <td class="align-middle text-dark font-weight-bold" style="max-width: 280px;">@item.Reason</td>
                                    <td class="align-middle pr-4">
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge badge-soft-success px-2.5 py-1.5 rounded-pill mb-1 d-inline-block">
                                                <i class="fas fa-check-circle mr-1"></i>Đã duyệt
                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge badge-soft-danger px-2.5 py-1.5 rounded-pill mb-1 d-inline-block">
                                                <i class="fas fa-times-circle mr-1"></i>Bị từ chối
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.AdminNote))
                                        {
                                            <div class="small text-muted mt-1"><strong class="text-dark">Phản hồi:</strong> @item.AdminNote</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted font-italic">Chưa có lịch sử xử lý đơn từ nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>