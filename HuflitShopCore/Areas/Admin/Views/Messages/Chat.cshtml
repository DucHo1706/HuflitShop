@{
    ViewData["Title"] = "Trung tâm Chăm sóc Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var sessions = ViewBag.Sessions as List<HuflitShopCore.Services.ChatSessionSummaryDTO> ?? new List<HuflitShopCore.Services.ChatSessionSummaryDTO>();
    var activeSessionId = ViewBag.ActiveSessionId as string;
    var activeUserId = ViewBag.ActiveUserId as string;
    var activeCustomerName = ViewBag.ActiveCustomerName as string;
    var activeCustomerAvatar = ViewBag.ActiveCustomerAvatar as string ?? "/Client/img/default-user.jpg";
}

<link href="/Admin/css/chat.css" rel="stylesheet" />

<style>
    .chat-app *, .chat-app *::before, .chat-app *::after {
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .chat-app {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        height: calc(100vh - 160px);
        min-height: 580px;
        position: relative;
    }

    .chat-app .people-list {
        width: 320px;
        background-color: #ffffff;
        border-right: 1px solid #f1f5f9;
        height: 100%;
        overflow-y: auto;
        padding: 0 !important;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 2;
    }

    .people-list .search {
        padding: 1.25rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        background-color: #ffffff;
        position: sticky;
        top: 0;
        z-index: 3;
    }

    .people-list .search-wrapper {
        display: flex;
        align-items: center;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 0.4rem 0.85rem;
        transition: all 0.2s ease;
    }

    .people-list .search-wrapper:focus-within {
        border-color: #0f172a;
        background-color: #ffffff;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.05);
    }

    .people-list .search-wrapper svg {
        color: #94a3b8;
        margin-right: 0.5rem;
        flex-shrink: 0;
    }

    .people-list .search input {
        border: none !important;
        background: transparent !important;
        outline: none !important;
        font-size: 0.85rem;
        color: #0f172a;
        width: 100%;
        padding: 0;
    }

    .people-list .chat-list {
        padding: 0;
        margin: 0;
    }

    .people-list .chat-list li {
        padding: 0.95rem 1.15rem;
        border-bottom: 1px solid #f8fafc;
        border-radius: 0 !important;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        cursor: pointer;
    }

    .people-list .chat-list li:hover {
        background-color: #f8fafc !important;
    }

    .people-list .chat-list li.active {
        background-color: #f1f5f9 !important;
        border-left: 4px solid #0f172a;
    }

    .people-list .chat-list li img {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #e2e8f0;
        flex-shrink: 0;
    }

    .people-list .about {
        padding-left: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
        min-width: 0;
    }

    .people-list .about .name {
        font-weight: 600;
        color: #0f172a;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .people-list .about .status {
        font-size: 0.78rem;
        color: #64748b;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
    }

    .people-list .about .preview-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    .people-list .about .time {
        font-size: 0.7rem;
        color: #94a3b8;
        flex-shrink: 0;
    }

    .chat-app .chat {
        margin-left: 320px;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    .chat .chat-header {
        padding: 0.95rem 1.5rem !important;
        border-bottom: 1px solid #f1f5f9 !important;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .chat .chat-header img {
        width: 42px;
        height: 42px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #e2e8f0;
    }

    .chat .chat-header .chat-about {
        padding-left: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .chat .chat-header .chat-about h6 {
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        font-size: 0.95rem;
    }

    .chat .chat-header .online-badge {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        color: #10b981;
        font-weight: 500;
    }

    .chat .chat-header .online-dot {
        width: 7px;
        height: 7px;
        background-color: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 6px #10b981;
    }

    .chat .chat-history {
        padding: 1.5rem !important;
        flex: 1;
        overflow-y: auto;
        background-color: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .chat-history::-webkit-scrollbar {
        width: 6px;
    }

    .chat-history::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

    .chat-history ul {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 0;
        padding: 0;
    }

    .chat-history .message-item {
        list-style: none;
        display: flex;
        flex-direction: column;
        max-width: 70%;
        animation: chatFadeIn 0.2s ease-in-out;
    }

    @@keyframes chatFadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .chat-history .message-item.received-msg {
        align-self: flex-start;
        align-items: flex-start;
    }

    .chat-history .message-item.sent-msg {
        align-self: flex-end;
        align-items: flex-end;
    }

    .chat-history .message-data {
        font-size: 0.72rem;
        color: #94a3b8;
        margin-bottom: 0.3rem;
    }

    .chat-history .message {
        padding: 0.7rem 1.1rem !important;
        font-size: 0.88rem !important;
        border-radius: 16px !important;
        line-height: 1.45 !important;
        word-break: break-word;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    }

    .chat-history .my-message {
        background-color: #ffffff !important;
        color: #0f172a !important;
        border-top-left-radius: 4px !important;
        border: 1px solid #e2e8f0 !important;
    }

    .chat-history .other-message {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
        color: #ffffff !important;
        border-top-right-radius: 4px !important;
        text-align: left !important;
    }

    .chat-history .message:after {
        display: none !important;
    }

    .chat .chat-message {
        padding: 0.85rem 1.5rem !important;
        border-top: 1px solid #f1f5f9;
        background: #ffffff;
    }

    .chat-message .input-group {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 0.3rem 0.4rem 0.3rem 1.1rem;
        display: flex;
        align-items: center;
        transition: all 0.2s ease;
    }

    .chat-message .input-group:focus-within {
        background-color: #ffffff;
        border-color: #0f172a;
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.05);
    }

    .chat-message .input-group input {
        border: none !important;
        background: transparent !important;
        padding: 0.4rem 0 !important;
        font-size: 0.88rem;
        color: #0f172a;
        outline: none !important;
        flex: 1;
    }

    .chat-message .input-group input::placeholder {
        color: #94a3b8;
    }

    .chat-message .input-group .btn-send {
        background-color: #0f172a !important;
        border: none !important;
        color: white !important;
        border-radius: 50% !important;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .chat-message .input-group .btn-send:hover {
        background-color: #e11d48 !important;
        transform: scale(1.05);
    }

    #chatPlaceholderArea {
        padding: 2rem;
        text-align: center;
    }

    .placeholder-icon-wrapper {
        width: 80px;
        height: 80px;
        background-color: #f8fafc;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        margin-bottom: 1.25rem;
    }

    .admin-page-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.3px;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <h1 class="admin-page-title">Trung tâm Chăm sóc Khách hàng</h1>
    </div>

    <div class="chat-app">
        <div id="plist" class="people-list">
            <div class="search">
                <div class="search-wrapper">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" id="searchClients" placeholder="Tìm kiếm khách hàng...">
                </div>
            </div>
            <ul class="list-unstyled chat-list" id="chatListContainer">
                @if (sessions.Any())
                {
                    foreach (var session in sessions)
                    {
                        bool isActive = session.SessionId == activeSessionId;
                        <li class="@(isActive ? "active" : "")" 
                            data-session-id="@session.SessionId" 
                            data-user-id="@session.UserId"
                            data-customer-name="@session.CustomerName"
                            data-customer-avatar="@session.CustomerAvatar"
                            onclick="selectSession(this)">
                            
                            <img src="@session.CustomerAvatar" alt="avatar">
                            <div class="about">
                                <div class="name">@session.CustomerName</div>
                                <div class="status">
                                    <span class="preview-text">@session.LastMessageContent</span>
                                    <span class="time">@session.LastMessageTime.ToString("HH:mm")</span>
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="text-center text-muted py-5" id="emptySessionMsg" style="font-size: 0.85rem;">Chưa có cuộc hội thoại nào</li>
                }
            </ul>
        </div>

        <div class="chat">
            <!-- Hộp Chat thật sự (ẩn/hiện động qua CSS) -->
            <div id="activeChatArea" style="display: @(string.IsNullOrEmpty(activeSessionId) ? "none" : "flex"); flex-direction: column; height: 100%;">
                <div class="chat-header clearfix">
                    <img id="activeAvatar" src="@activeCustomerAvatar" alt="avatar">
                    <div class="chat-about">
                        <h6 id="activeTitle">@activeCustomerName</h6>
                        <span class="online-badge">
                            <span class="online-dot"></span> Trực tuyến
                        </span>
                    </div>
                </div>
                
                <div class="chat-history">
                    <ul id="chatMessageList" class="m-b-0">
                        <!-- Tin nhắn tải động qua AJAX/SignalR -->
                    </ul>
                </div>
                
                <div class="chat-message clearfix">
                    <div class="input-group">
                        <input type="text" id="chatInputMessage" placeholder="Nhập tin nhắn phản hồi..." onkeypress="handleKeyPress(event)">
                        <button class="btn btn-send" id="btnSendChat" onclick="sendMessage()">
                            <!-- Icon Gửi SVG -->
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"/>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Màn hình chờ khi chưa chọn cuộc hội thoại -->
            <div id="chatPlaceholderArea" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted" style="display: @(string.IsNullOrEmpty(activeSessionId) ? "flex" : "none") !important;">
                <div class="placeholder-icon-wrapper">
                    <!-- Icon Chat Placeholder SVG -->
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </div>
                <h6 class="fw-bold text-dark mb-1">Bắt đầu tư vấn khách hàng</h6>
                <p style="font-size: 0.83rem; color: #94a3b8;">Chọn một cuộc hội thoại ở danh sách bên trái để xem nội dung tin nhắn.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Script SignalR -->
    <script src="/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        var activeSessionId = '@activeSessionId';
        var activeUserId = '@activeUserId';

        // 1. Kết nối SignalR Hub
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.start().then(function () {
            console.log("SignalR Connected to ChatHub!");
        }).catch(function (err) {
            return console.error(err.toString());
        });

        // 2. Lắng nghe tin nhắn gửi từ cả User hoặc Admin
        connection.on("ReceiveAdminMessage", function (data) {
            // Cập nhật dòng preview tin nhắn cuối ở cột danh sách bên trái
            updateSidebarItem(data);

            // Bật thông báo âm thanh nếu tin nhắn được gửi từ User
            if (data.senderType === 'User') {
                playNotificationSound();
            }

            // Nếu đang mở đúng khung chat của SessionId đó thì hiển thị tin nhắn ngay lập tức
            if (activeSessionId === data.sessionId) {
                appendMessage(data.senderType, data.messageContent, data.sentAt);
                scrollToBottom();
            }
        });

        // 3. Hàm chuyển đổi khung chat khi click vào danh sách bên trái
        function selectSession(element) {
            // Thay đổi giao diện active
            document.querySelectorAll('#chatListContainer li').forEach(li => li.classList.remove('active'));
            element.classList.add('active');

            activeSessionId = element.getAttribute('data-session-id');
            activeUserId = element.getAttribute('data-user-id');
            var customerName = element.getAttribute('data-customer-name');
            var customerAvatar = element.getAttribute('data-customer-avatar');

            // Ẩn màn hình chờ và hiển thị khung chat thực sự
            document.getElementById('activeChatArea').style.display = 'flex';
            document.getElementById('chatPlaceholderArea').style.setProperty('display', 'none', 'important');

            // Cập nhật thông tin Header
            document.getElementById('activeTitle').innerText = customerName;
            document.getElementById('activeAvatar').src = customerAvatar;

            // Load lịch sử tin nhắn
            loadChatHistory(activeSessionId);
        }

        // Tải lịch sử chat
        function loadChatHistory(sessionId) {
            fetch(`/Admin/Messages/GetChatHistory?sessionId=${sessionId}`)
                .then(res => res.json())
                .then(messages => {
                    var container = document.getElementById('chatMessageList');
                    container.innerHTML = ''; 

                    messages.forEach(m => {
                        appendMessage(m.senderType, m.messageContent, m.sentAt);
                    });

                    scrollToBottom();
                })
                .catch(err => console.error("Lỗi khi lấy lịch sử chat: ", err));
        }

        // Append tin nhắn vào khung chat
        function appendMessage(senderType, content, time) {
            var container = document.getElementById('chatMessageList');
            if (!container) return;

            var li = document.createElement('li');
            li.className = 'message-item ' + (senderType === 'User' ? 'received-msg' : 'sent-msg');

            var timeDiv = document.createElement('div');
            timeDiv.className = 'message-data';
            timeDiv.innerHTML = `<span class="message-data-time">${time}</span>`;

            var contentDiv = document.createElement('div');
            contentDiv.className = 'message ' + (senderType === 'User' ? 'my-message' : 'other-message');
            contentDiv.innerText = content;

            li.appendChild(timeDiv);
            li.appendChild(contentDiv);
            container.appendChild(li);
        }

        // Gửi tin nhắn
        function sendMessage() {
            var input = document.getElementById('chatInputMessage');
            var messageText = input.value.trim();
            if (!messageText || !activeUserId) return;

            // Gọi hàm trên Hub
            connection.invoke("SendMessageToUser", activeUserId, messageText)
                .then(function() {
                    input.value = ''; // Xóa text đã nhập
                })
                .catch(function (err) {
                    return console.error(err.toString());
                });
        }

        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }

        function scrollToBottom() {
            var historyContainer = document.querySelector('.chat-history');
            if (historyContainer) {
                historyContainer.scrollTop = historyContainer.scrollHeight;
            }
        }

        // Cập nhật preview tin nhắn ở thanh sidebar bên trái và đẩy lên đầu list
        function updateSidebarItem(data) {
            var li = document.querySelector(`#chatListContainer li[data-session-id="${data.sessionId}"]`);
            var listContainer = document.getElementById('chatListContainer');
            
            // Xóa dòng thông báo trống nếu có
            var emptyMsg = document.getElementById('emptySessionMsg');
            if (emptyMsg) {
                emptyMsg.remove();
            }

            if (li) {
                // Cập nhật text xem trước
                li.querySelector('.preview-text').innerText = data.messageContent;
                li.querySelector('.time').innerText = data.sentAt;
                
                // Đẩy dòng này lên đầu danh sách
                listContainer.insertBefore(li, listContainer.firstChild);
            } else {
                // Tạo mới dòng khách hàng nếu chưa có trong danh sách hiện tại
                var newLi = document.createElement('li');
                newLi.setAttribute('data-session-id', data.sessionId);
                newLi.setAttribute('data-user-id', data.userId);
                newLi.setAttribute('data-customer-name', data.customerName);
                newLi.setAttribute('data-customer-avatar', data.customerAvatar);
                newLi.onclick = function() { selectSession(this); };
                
                newLi.innerHTML = `
                    <img src="${data.customerAvatar}" alt="avatar">
                    <div class="about">
                        <div class="name">${data.customerName}</div>
                        <div class="status">
                            <span class="preview-text">${data.messageContent}</span>
                            <span class="time">${data.sentAt}</span>
                        </div>
                    </div>
                `;
                
                listContainer.insertBefore(newLi, listContainer.firstChild);
            }
        }

        // Hàm phát âm thanh thông báo
        function playNotificationSound() {
            try {
                // Tạo nhanh một AudioContext để bíp bíp nhẹ nhàng
                var context = new (window.AudioContext || window.webkitAudioContext)();
                var osc = context.createOscillator();
                var gain = context.createGain();
                osc.type = "sine";
                osc.frequency.value = 523.25; // Nốt Đô (C5) tinh tế
                gain.gain.setValueAtTime(0.08, context.currentTime); // Âm lượng nhẹ nhàng
                osc.connect(gain);
                gain.connect(context.destination);
                osc.start();
                osc.stop(context.currentTime + 0.15); // Phát trong 0.15 giây
            } catch (e) {
                console.log("Audio notification failed or blocked: ", e);
            }
        }

        // Tìm kiếm khách hàng trong list bên trái
        document.getElementById('searchClients')?.addEventListener('input', function(e) {
            var search = e.target.value.toLowerCase().trim();
            document.querySelectorAll('#chatListContainer li').forEach(li => {
                var name = li.querySelector('.name').innerText.toLowerCase();
                if (name.includes(search)) {
                    li.style.display = 'flex';
                } else {
                    li.style.display = 'none';
                }
            });
        });

        if (activeSessionId) {
            loadChatHistory(activeSessionId);
        }
    </script>
}