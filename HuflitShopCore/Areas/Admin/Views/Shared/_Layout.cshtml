    <!-- SignalR for Real-time System Notifications -->
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        $(document).ready(function () {
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveSystemNotification", function (data) {
                console.log("System Notification received:", data);
                
                // Play notification chime sound
                try {
                    var audio = new Audio("https://assets.mixkit.co/active_storage/sfx/2869/2869-84.wav");
                    audio.play().catch(function(e) {
                        console.log("Audio block: user interaction required.");
                    });
                } catch (e) {
                    console.log("Sound failed", e);
                }

                // Show SweetAlert popup notification
                if (typeof swal === "function") {
                    swal({
                        title: data.title,
                        text: data.message,
                        icon: data.icon || "info",
                        button: "Đóng"
                    });
                } else {
                    alert(data.title + "\n" + data.message);
                }

                // Dispatch custom event for real-time list updates
                if (data.type === "NewOrder") {
                    window.dispatchEvent(new CustomEvent('NewOrderReceived', { detail: data }));
                }
            });

            connection.start()
                .then(function () {
                    console.log("Global System Notification connection established successfully!");
                })
                .catch(function (err) {
                    console.error("SignalR connection failed: ", err.toString());
                });
        });
    </script>

