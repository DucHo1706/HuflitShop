@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.ViewEngines
@using Microsoft.EntityFrameworkCore
@using HuflitShopCore.Models

@inject HuflitShopCore.Data.AppDbContext _context

@{
    string activePage = System.IO.Path.GetFileNameWithoutExtension(ViewContext.ActionDescriptor.DisplayName);
    Func<string, string, string> ActiveClass = (string activePage, string page) =>
    {
        return (activePage == page) ? "active" : "";
    };

    string userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? User.FindFirstValue("Id") ?? "";
    bool isAdmin = User.IsInRole("1") || User.IsInRole("ROLE-ADMIN");

    // Tối ưu hóa truy vấn: Lấy danh sách đơn hàng chờ duyệt trong 1 câu lệnh duy nhất không tracking
    var pendingOrders = _context.Orders
        .AsNoTracking()
        .Where(o => o.OrderStatus == 0)
        .Select(o => new {
            o.Id,
            o.OrderDate,
            o.UserId,
            UserFullName = o.User != null ? o.User.FullName : "Khách hàng",
            UserAvatar = o.User != null ? o.User.Avatar : null
        })
        .ToList();

    int pendingCount = pendingOrders.Count;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>@ViewData["title"] - Admin</title>


    <!-- Custom fonts for this template-->
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/Admin/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/Admin/css/admin-custom.css" rel="stylesheet">

    <!-- Paging -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/dataTables.bootstrap5.min.css" />

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        /* Custom Select2 premium theme styles matching Excel Navy/sb-admin-2 theme */
        .select2-container--default .select2-selection--single {
            height: 38px !important;
            border: 1px solid #d1d3e2 !important;
            border-radius: 6px !important;
            padding: 5px 10px !important;
            display: flex;
            align-items: center;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 26px !important;
            color: #6e707e !important;
            padding-left: 0 !important;
        }
    </style>
    

    <!-- Custom CSS for Toast-like Alerts -->
    <style>
        .toast-container {
            position: fixed;
            top: 80px; /* Dưới thanh Topbar một chút */
            right: 20px;
            z-index: 1055; /* Hiển thị trên hầu hết các element khác */
        }
    </style>


</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-area="Admin" asp-controller="Home" asp-action="Index">
                <div class="sidebar-brand-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="sidebar-brand-text mx-3">Tracy ERP</div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0">

            <!-- Phân khúc 1: TỔNG QUAN & BÁO CÁO -->
            <div class="sidebar-heading">Tổng quan & Phân tích</div>
            
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-chart-pie"></i>
                    <span>Bảng tổng quan</span>
                </a>
            </li>

            @if (isAdmin)
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Report" asp-action="Index">
                        <i class="fas fa-chart-line"></i>
                        <span>Thống kê doanh thu</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="WarehouseReport" asp-action="Index">
                        <i class="fas fa-warehouse"></i>
                        <span>Báo cáo kho BI</span>
                    </a>
                </li>
            }
            
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Instruction">
                    <i class="fas fa-book-open"></i>
                    <span>Tài liệu vận hành</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Phân khúc 2: BÁN HÀNG & KHÁCH HÀNG -->
            <div class="sidebar-heading">Kinh doanh & Khách hàng</div>

            <!-- Đơn hàng -->
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseSales" aria-expanded="true">
                    <i class="fas fa-shopping-bag"></i>
                    <span>
                        Quản lý bán hàng
                        @if (pendingCount != 0)
                        {
                            <span class="badge badge-danger ml-1">@pendingCount</span>
                        }
                    </span>
                </a>
                <div id="collapseSales" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Order" asp-action="Index">Tất cả đơn hàng</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pendingOnly="true">Đơn hàng chờ duyệt</a>
                    </div>
                </div>
            </li>

            <!-- Khách hàng & Phản hồi -->
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseCRM" aria-expanded="true">
                    <i class="fas fa-users-cog"></i>
                    <span>Khách hàng & CSKH</span>
                </a>
                <div id="collapseCRM" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Customer" asp-action="Index">Danh sách khách hàng</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Reviews" asp-action="Index">Đánh giá & Phản hồi</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Messages" asp-action="Chat" asp-route-userId="">Tư vấn Chat (Live)</a>
                    </div>
                </div>
            </li>

            <!-- Khuyến mãi -->
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Promotions" asp-action="Index">
                    <i class="fas fa-tags"></i>
                    <span>Khuyến mãi & Combo</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Phân khúc 3: SẢN PHẨM & VẬN HÀNH KHO -->
            <div class="sidebar-heading">Sản phẩm & Vận hành kho</div>

            <!-- Sản phẩm -->
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseProductsList" aria-expanded="true">
                    <i class="fas fa-box-open"></i>
                    <span>Quản lý sản phẩm</span>
                </a>
                <div id="collapseProductsList" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-id="0">Sản phẩm</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Danh mục</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Color" asp-action="Index">Màu sắc (Colors)</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Size" asp-action="Index">Kích thước (Sizes)</a>
                    </div>
                </div>
            </li>

            <!-- Nhập kho & Nhà cung cấp -->
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseInventory" aria-expanded="true">
                    <i class="fas fa-warehouse"></i>
                    <span>Quản lý kho hàng</span>
                </a>
                <div id="collapseInventory" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Supplier" asp-action="Index">Nhà cung cấp</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="StockReceipt" asp-action="Create">Lập phiếu nhập kho</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="StockReceipt" asp-action="Index">Lịch sử nhập kho</a>
                    </div>
                </div>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Phân khúc 4: NHÂN SỰ & CHẤM CÔNG -->
            <div class="sidebar-heading">Quản trị nhân sự (HRM)</div>

            @if (isAdmin)
            {
                <!-- Nhân viên -->
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Employee" asp-action="Index">
                        <i class="fas fa-user-tie"></i>
                        <span>Danh sách nhân viên</span>
                    </a>
                </li>
                
                <!-- Duyệt & phân lịch -->
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseHRMOps" aria-expanded="true">
                        <i class="fas fa-calendar-check"></i>
                        <span>Vận hành & Đăng ký ca</span>
                    </a>
                    <div id="collapseHRMOps" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <a class="collapse-item" asp-area="Admin" asp-controller="ShiftRegistrations" asp-action="Index">Duyệt ca làm</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="WorkSchedules" asp-action="Index">Bảng phân ca tuần</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Requests" asp-action="Index">Đơn từ chờ duyệt</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Requests" asp-action="History">Lịch sử duyệt đơn</a>
                        </div>
                    </div>
                </li>

                <!-- Lương & Cấu hình -->
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseHRMSettings" aria-expanded="true">
                        <i class="fas fa-cogs"></i>
                        <span>Tài chính & Thiết lập</span>
                    </a>
                    <div id="collapseHRMSettings" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <a class="collapse-item" asp-area="Admin" asp-controller="Salary" asp-action="Index">Bảng lương tổng hợp</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Shifts" asp-action="Index">Định nghĩa ca làm</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="ShopSetting" asp-action="Index">Cấu hình IP Wifi</a>
                        </div>
                    </div>
                </li>
            }
            else
            {
                <!-- Nhân viên cá nhân -->
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseMyHRM" aria-expanded="true">
                        <i class="fas fa-user-circle"></i>
                        <span>Cá nhân & Ca làm</span>
                    </a>
                    <div id="collapseMyHRM" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <a class="collapse-item" asp-area="" asp-controller="Profile" asp-action="Profile">Hồ sơ cá nhân</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Salary" asp-action="MySalary">Bảng lương của tôi</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="StaffShift" asp-action="Index">Đăng ký ca làm</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Attendance" asp-action="Index">Chấm công Check-in</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Requests" asp-action="MyRequests">Gửi đơn từ / Yêu cầu</a>
                        </div>
                    </div>
                </li>
            }

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler (Sidebar) -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>

        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">

                        <!-- Nav Item - Search Dropdown (Visible Only XS) -->
                        <li class="nav-item dropdown no-arrow d-sm-none">
                            <a class="nav-link dropdown-toggle" href="#" id="searchDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-search fa-fw"></i>
                            </a>
                            <!-- Dropdown - Messages -->
                            <div class="dropdown-menu dropdown-menu-right p-3 shadow animated--grow-in"
                                 aria-labelledby="searchDropdown">
                                <form class="form-inline mr-auto w-100 navbar-search">
                                    <div class="input-group">
                                        <input type="text" class="form-control bg-light border-0 small"
                                               placeholder="Tìm kiếm ..." aria-label="Search"
                                               aria-describedby="basic-addon2">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="button">
                                                <i class="fas fa-search fa-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </li>

                        <!-- Nav Item - Alerts -->
                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-bell fa-fw" style="color: #D7DF01;"></i>
                                <!-- Counter - Alerts -->
                                @if (pendingCount != 0)
                                {
                                    <span class="badge badge-danger badge-counter">
                                        @pendingCount
                                    </span>
                                }

                            </a>
                            <!-- Dropdown - Alerts -->
                            @if (pendingCount != 0)
                            {
                                <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                     aria-labelledby="alertsDropdown">
                                    <h6 class="dropdown-header">
                                        Thông báo
                                    </h6>
                                    @foreach (var item in pendingOrders)
                                    {
                                        <a class="dropdown-item d-flex align-items-center" asp-action="Index" asp-route-pendingOnly="true" asp-controller="Order" asp-area="Admin">
                                            <div class="dropdown-list-image mr-3">
                                                @if (!string.IsNullOrEmpty(item.UserAvatar))
                                                {
                                                    <img class="rounded-circle" src="@item.UserAvatar" alt="...">
                                                }
                                                else
                                                {
                                                    <img class="rounded-circle" src="~/Client/img/default-user.jpg" alt="..." />
                                                }
                                            </div>
                                            <div>
                                                @{
                                                    TimeSpan time = DateTime.Now - item.OrderDate;
                                                    int totalDays = (int)time.TotalDays;
                                                    if (totalDays > 1)
                                                    {
                                                        <div class="small text-gray-500">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                                    }
                                                    else if (totalDays == 1)
                                                    {
                                                        <div class="small text-gray-500">1 ngày trước</div>
                                                    }
                                                    else
                                                    {
                                                        int totalHours = (int)time.TotalHours;
                                                        if (totalHours < 1)
                                                        {
                                                            int totalMinutes = (int)time.TotalMinutes;
                                                            if (totalMinutes < 1)
                                                            {
                                                                <div class="small text-gray-500">Vừa xong</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="small text-gray-500">@totalMinutes phút trước</div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="small text-gray-500">@totalHours giờ trước</div>
                                                        }
                                                    }
                                                }
                                                <span class="font-weight-bold">@item.UserFullName đã đặt một đơn hàng. Nhấn để xem chi tiết.</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                     aria-labelledby="alertsDropdown">
                                    <h6 class="dropdown-header">
                                        Thông báo
                                    </h6>
                                    <div class="text-center" style="margin-top: 5%; margin-bottom: 5%;">
                                        Chưa có thông báo mới.
                                    </div>
                                </div>
                            }
                        </li>
                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                @if (isAdmin)
                                {
                                    <span class="mr-2 d-none d-lg-inline text-gray-600 small"><b>Xin chào, Admin: </b>@User.Identity?.Name</span>
                                }
                                else
                                {
                                    <span class="mr-2 d-none d-lg-inline text-gray-600 small"><b>Xin chào, Nhân viên: </b>@User.Identity?.Name</span>
                                }

                                @if (string.IsNullOrEmpty(User.FindFirst("Avatar")?.Value))
                                {
                                    <img class="img-profile rounded-circle" src="~/Client/img/default-user.jpg" alt="">
                                }
                                else
                                {
                                    <img class="img-profile rounded-circle" src="@User.FindFirst("Avatar")?.Value" alt="">
                                }
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <a class="dropdown-item" asp-area="Admin" asp-controller="Profiles" asp-action="Profiles">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Hồ sơ
                                </a>
                                <div class="dropdown-divider"></div>

                                <a class="dropdown-item" asp-area="" asp-action="Logout" asp-controller="Login"
                                   asp-route-returnUrl="@Url.Action("Index","Home",new {Area="Admin"})">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Đăng xuất
                                </a>


                            </div>
                        </li>

                    </ul>

                </nav>
                <!-- End of Topbar -->
                <!-- Begin Page Content -->
                <div class="container-fluid">

                    @RenderBody()
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; HUFLIT SHOP @DateTime.Now.Year</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Toast Notification Container -->
    <div class="toast-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-sm alert-dismissible fade show" role="alert" style="min-width: 350px;">
                <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm alert-dismissible fade show" role="alert" style="min-width: 350px;">
                <i class="fas fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
        }
    </div>


    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/Admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/Admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    @*<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>*@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/Admin/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/Admin/js/sb-admin-2.min.js"></script>

    <!--Page level plugin-->
    <script src="~/Admin/vendor/chart.js/Chart.min.js"></script>

    <!-- Paging & Select2 -->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.3/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
