@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.ViewEngines
@using Microsoft.EntityFrameworkCore
@using HuflitShopCore.Models

@inject HuflitShopCore.Data.AppDbContext _context

@{
    string activePage = System.IO.Path.GetFileNameWithoutExtension(ViewContext.ActionDescriptor.DisplayName);
    Func<string, string, string> ActiveClass = (string activePage, string page) =>
    {
        return (activePage == page) ? "active" : "";
    };

    string userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? User.FindFirstValue("Id") ?? "";
    bool isAdmin = User.IsInRole("1") || User.IsInRole("ROLE-ADMIN");

    // Truy vấn đơn hàng chờ duyệt không tracking
    var pendingOrders = _context.Orders
        .AsNoTracking()
        .Where(o => o.OrderStatus == 0)
        .Select(o => new {
            o.Id,
            o.OrderDate,
            o.UserId,
            UserFullName = o.User != null ? o.User.FullName : "Khách hàng",
            UserAvatar = o.User != null ? o.User.Avatar : null
        })
        .ToList();

    int pendingCount = pendingOrders.Count;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="HuflitShop ERP Dashboard">
    <meta name="author" content="HuflitShop Team">

    <title>@ViewData["title"] - Hệ Thống Quản Trị ERP</title>

    <!-- Custom fonts -->
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- SB Admin 2 & Global Styles -->
    <link href="~/Admin/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/Admin/css/admin-custom.css" rel="stylesheet">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/dataTables.bootstrap5.min.css" />

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        :root {
            --admin-ocean: #2563eb;
            --admin-cyan: #06b6d4;
            --admin-dark: #0f172a;
            --admin-bg: #f8fafc;
            --admin-border: #e2e8f0;
            --admin-gradient: linear-gradient(135deg, #2563eb 0%, #06b6d4 100%);
            --admin-sidebar-gradient: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            --admin-transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        body {
            font-family: 'Jost', sans-serif !important;
            background-color: var(--admin-bg) !important;
            color: var(--admin-dark);
        }

        /* Modernized Sidebar */
        .sidebar-dark {
            background: var(--admin-sidebar-gradient) !important;
            border-right: 1px solid #1e293b;
        }

        .sidebar-brand {
            height: 4.5rem !important;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-brand-text {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 1px;
            background: var(--admin-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-brand-icon i {
            color: var(--admin-cyan);
            font-size: 1.4rem;
        }

        .sidebar-dark .sidebar-heading {
            color: #64748b !important;
            font-size: 0.7rem !important;
            font-weight: 700 !important;
            letter-spacing: 1.2px !important;
            text-transform: uppercase;
            padding: 1.25rem 1rem 0.5rem 1rem !important;
        }

        .sidebar-dark .nav-item .nav-link {
            padding: 0.8rem 1rem !important;
            font-weight: 500;
            color: #94a3b8 !important;
            transition: var(--admin-transition);
        }

        .sidebar-dark .nav-item .nav-link i {
            color: #64748b !important;
            transition: var(--admin-transition);
            width: 1.5rem;
        }

        .sidebar-dark .nav-item:hover .nav-link,
        .sidebar-dark .nav-item.active .nav-link {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.05);
        }

        .sidebar-dark .nav-item:hover .nav-link i,
        .sidebar-dark .nav-item.active .nav-link i {
            color: var(--admin-cyan) !important;
        }

        /* -------------------------------------------------------------
           SỬA TRIỆT ĐỂ LỖI CHE KHUẤT DROPDOWN THÔNG BÁO (STACKING CONTEXT)
           ------------------------------------------------------------- */
        .topbar {
            height: 4.5rem !important;
            background: #ffffff !important;
            border-bottom: 1px solid var(--admin-border);
            box-shadow: 0 4px 20px -5px rgba(15, 23, 42, 0.03) !important;
            position: relative !important;
            z-index: 1040 !important; /* Đảm bảo thanh Topbar nổi trên toàn bộ Body */
        }

        .topbar .navbar-nav {
            position: relative;
            z-index: 1045 !important;
        }

        .topbar .nav-item {
            position: relative !important;
        }

        .topbar .nav-item .nav-link {
            height: 4.5rem !important;
        }

        /* Fix Menu Dropdown Thông Báo nổi tuyệt đối lên tầng cao nhất */
        .topbar .dropdown-menu {
            position: absolute !important;
            z-index: 1060 !important; /* Cao hơn Topbar và các Card ở Body */
        }

        .topbar .dropdown-list {
            width: 22rem !important;
            padding: 0;
            border: 1px solid var(--admin-border) !important;
            box-shadow: 0 15px 35px -5px rgba(15, 23, 42, 0.2) !important;
            border-radius: 0.5rem;
            overflow: hidden;
            background: #ffffff !important;
        }

        .topbar .dropdown-list .dropdown-list-content {
            max-height: 340px; /* Chiều cao cố định tạo scrollbar */
            overflow-y: auto !important;
        }

        .topbar .dropdown-list .dropdown-list-content::-webkit-scrollbar {
            width: 5px;
        }

        .topbar .dropdown-list .dropdown-list-content::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        /* Custom Badge */
        .badge-counter-ocean {
            background: #ef4444;
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.25em 0.55em;
            border-radius: 10px;
        }

        /* Toast Container */
        .toast-container {
            position: fixed;
            top: 90px;
            right: 25px;
            z-index: 1070;
        }

        .toast-container .alert {
            border: 1px solid var(--admin-border);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
            border-left: 4px solid var(--admin-ocean);
            border-radius: 0.35rem;
            padding: 1rem 1.25rem;
            min-width: 320px;
        }

        /* Select2 Custom Theme */
        .select2-container--default .select2-selection--single {
            height: 42px !important;
            border: 1px solid var(--admin-border) !important;
            border-radius: 0.35rem !important;
            padding: 6px 12px !important;
            background-color: #ffffff !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 28px !important;
            color: var(--admin-dark) !important;
        }

        /* Footer Modern */
        footer.sticky-footer {
            padding: 1.5rem 0 !important;
            background: #ffffff !important;
            border-top: 1px solid var(--admin-border);
            color: #64748b;
            font-size: 0.85rem;
        }
    </style>
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-area="Admin" asp-controller="Home" asp-action="Index">
                <div class="sidebar-brand-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="sidebar-brand-text mx-3">HUFLITSHOP</div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0 border-secondary opacity-25">

            <!-- Phân khúc 1: TỔNG QUAN & BÁO CÁO -->
            <div class="sidebar-heading">Tổng quan & Phân tích</div>
            
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-chart-pie"></i>
                    <span>Bảng tổng quan</span>
                </a>
            </li>

            @if (isAdmin)
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Report" asp-action="Index">
                        <i class="fas fa-chart-line"></i>
                        <span>Thống kê doanh thu</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="WarehouseReport" asp-action="Index">
                        <i class="fas fa-warehouse"></i>
                        <span>Báo cáo kho BI</span>
                    </a>
                </li>
            }
            
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Instruction">
                    <i class="fas fa-book-open"></i>
                    <span>Tài liệu vận hành</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider border-secondary opacity-25">

            <!-- Phân khúc 2: BÁN HÀNG & KHÁCH HÀNG -->
            <div class="sidebar-heading">Kinh doanh & Khách hàng</div>

            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseSales" aria-expanded="true">
                    <i class="fas fa-shopping-bag"></i>
                    <span>
                        Quản lý bán hàng
                        @if (pendingCount != 0)
                        {
                            <span class="badge badge-counter-ocean ml-1">@pendingCount</span>
                        }
                    </span>
                </a>
                <div id="collapseSales" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded border">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Order" asp-action="Index">Tất cả đơn hàng</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-pendingOnly="true">Đơn chờ duyệt</a>
                    </div>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseCRM" aria-expanded="true">
                    <i class="fas fa-users-cog"></i>
                    <span>Khách hàng & CSKH</span>
                </a>
                <div id="collapseCRM" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded border">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Customer" asp-action="Index">Danh sách khách hàng</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Reviews" asp-action="Index">Đánh giá & Phản hồi</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Messages" asp-action="Chat" asp-route-userId="">Tư vấn Chat (Live)</a>
                    </div>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Promotions" asp-action="Index">
                    <i class="fas fa-tags"></i>
                    <span>Khuyến mãi & Combo</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider border-secondary opacity-25">

            <!-- Phân khúc 3: SẢN PHẨM & VẬN HÀNH KHO -->
            <div class="sidebar-heading">Sản phẩm & Vận hành kho</div>

            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseProductsList" aria-expanded="true">
                    <i class="fas fa-box-open"></i>
                    <span>Quản lý sản phẩm</span>
                </a>
                <div id="collapseProductsList" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded border">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-id="0">Sản phẩm</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Danh mục</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Color" asp-action="Index">Màu sắc (Colors)</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="Size" asp-action="Index">Kích thước (Sizes)</a>
                    </div>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseInventory" aria-expanded="true">
                    <i class="fas fa-boxes"></i>
                    <span>Quản lý kho hàng</span>
                </a>
                <div id="collapseInventory" class="collapse" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded border">
                        <a class="collapse-item" asp-area="Admin" asp-controller="Supplier" asp-action="Index">Nhà cung cấp</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="StockReceipt" asp-action="Create">Lập phiếu nhập kho</a>
                        <a class="collapse-item" asp-area="Admin" asp-controller="StockReceipt" asp-action="Index">Lịch sử nhập kho</a>
                    </div>
                </div>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider border-secondary opacity-25">

            <!-- Phân khúc 4: NHÂN SỰ & CHẤM CÔNG -->
            <div class="sidebar-heading">Quản trị nhân sự (HRM)</div>

            @if (isAdmin)
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Employee" asp-action="Index">
                        <i class="fas fa-user-tie"></i>
                        <span>Danh sách nhân viên</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseHRMOps" aria-expanded="true">
                        <i class="fas fa-calendar-check"></i>
                        <span>Vận hành & Đăng ký ca</span>
                    </a>
                    <div id="collapseHRMOps" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded border">
                            <a class="collapse-item" asp-area="Admin" asp-controller="ShiftRegistrations" asp-action="Index">Duyệt ca làm</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="WorkSchedules" asp-action="Index">Bảng phân ca tuần</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Requests" asp-action="Index">Đơn từ chờ duyệt</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Requests" asp-action="History">Lịch sử duyệt đơn</a>
                        </div>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseHRMSettings" aria-expanded="true">
                        <i class="fas fa-cogs"></i>
                        <span>Tài chính & Thiết lập</span>
                    </a>
                    <div id="collapseHRMSettings" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded border">
                            <a class="collapse-item" asp-area="Admin" asp-controller="Salary" asp-action="Index">Bảng lương tổng hợp</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Shifts" asp-action="Index">Định nghĩa ca làm</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="ShopSetting" asp-action="Index">Cấu hình IP Wifi</a>
                        </div>
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseMyHRM" aria-expanded="true">
                        <i class="fas fa-user-circle"></i>
                        <span>Cá nhân & Ca làm</span>
                    </a>
                    <div id="collapseMyHRM" class="collapse" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded border">
                            <a class="collapse-item" asp-area="" asp-controller="Profile" asp-action="Profile">Hồ sơ cá nhân</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Salary" asp-action="MySalary">Bảng lương của tôi</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="StaffShift" asp-action="Index">Đăng ký ca làm</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Attendance" asp-action="Index">Chấm công Check-in</a>
                            <a class="collapse-item" asp-area="Admin" asp-controller="Requests" asp-action="MyRequests">Gửi đơn từ / Yêu cầu</a>
                        </div>
                    </div>
                </li>
            }

            <hr class="sidebar-divider d-none d-md-block border-secondary opacity-25">

            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar Header -->
                <nav class="navbar navbar-expand navbar-light topbar mb-4 static-top">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars text-dark"></i>
                    </button>

                    <ul class="navbar-nav ml-auto align-items-center">

                        <!-- Notifications Dropdown -->
                        <li class="nav-item dropdown no-arrow mx-2">
                            <a class="nav-link dropdown-toggle position-relative" href="#" id="alertsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-bell fa-fw" style="color: var(--admin-ocean); font-size: 1.1rem;"></i>
                                @if (pendingCount != 0)
                                {
                                    <span class="badge badge-counter-ocean position-absolute" style="top: 18px; right: 2px;">
                                        @pendingCount
                                    </span>
                                }
                            </a>
                            
                            @if (pendingCount != 0)
                            {
                                <div class="dropdown-list dropdown-menu dropdown-menu-right border-0 animated--grow-in" aria-labelledby="alertsDropdown">
                                    <h6 class="dropdown-header text-uppercase font-weight-bold" style="background: var(--admin-dark); color: #fff; padding: 12px 16px;">
                                        Thông Báo Đơn Hàng Mới (@pendingCount)
                                    </h6>
                                    
                                    <!-- Khung bọc danh sách có thể scroll mượt mà -->
                                    <div class="dropdown-list-content">
                                        @foreach (var item in pendingOrders)
                                        {
                                            <a class="dropdown-item d-flex align-items-center py-3 border-bottom" asp-action="Index" asp-route-pendingOnly="true" asp-controller="Order" asp-area="Admin">
                                                <div class="dropdown-list-image mr-3 flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(item.UserAvatar))
                                                    {
                                                        <img class="rounded-circle" src="@item.UserAvatar" alt="Avatar" style="width: 38px; height: 38px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <img class="rounded-circle" src="~/Client/img/default-user.jpg" alt="Avatar" style="width: 38px; height: 38px; object-fit: cover;" />
                                                    }
                                                </div>
                                                <div>
                                                    <div class="small text-muted mb-1">
                                                        @{
                                                            TimeSpan time = DateTime.Now - item.OrderDate;
                                                            int totalDays = (int)time.TotalDays;
                                                            if (totalDays > 0) { <text>@totalDays ngày trước</text> }
                                                            else if ((int)time.TotalHours > 0) { <text>@((int)time.TotalHours) giờ trước</text> }
                                                            else { <text>Vừa xong</text> }
                                                        }
                                                    </div>
                                                    <span class="font-weight-bold text-dark" style="font-size: 0.85rem;">@item.UserFullName vừa tạo đơn hàng mới.</span>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                    
                                    <a class="dropdown-item text-center small text-gray-500 py-2 font-weight-bold" asp-action="Index" asp-route-pendingOnly="true" asp-controller="Order" asp-area="Admin">
                                        Xem tất cả đơn chờ duyệt &rarr;
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="dropdown-list dropdown-menu dropdown-menu-right border-0 animated--grow-in" aria-labelledby="alertsDropdown">
                                    <h6 class="dropdown-header text-uppercase font-weight-bold" style="background: var(--admin-dark); color: #fff; padding: 12px 16px;">
                                        Thông Báo
                                    </h6>
                                    <div class="text-center py-4 text-muted font-weight-bold small">
                                        Không có thông báo mới.
                                    </div>
                                </div>
                            }
                        </li>

                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- User Profile Dropdown -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-dark font-weight-bold small">
                                    @(isAdmin ? "Admin: " : "NV: ") @User.Identity?.Name
                                </span>
                                @if (string.IsNullOrEmpty(User.FindFirst("Avatar")?.Value))
                                {
                                    <img class="img-profile rounded-circle" src="~/Client/img/default-user.jpg" alt="User">
                                }
                                else
                                {
                                    <img class="img-profile rounded-circle" src="@User.FindFirst("Avatar")?.Value" alt="User">
                                }
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow border-0 animated--grow-in" aria-labelledby="userDropdown">

                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item py-2 text-danger font-weight-bold" asp-area="" asp-action="Logout" asp-controller="Login" asp-route-returnUrl="@Url.Action("Index","Home",new {Area="Admin"})">
                                    <i class="fas fa-sign-out-alt mr-2"></i>Đăng xuất
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>

                <!-- Page Main Render Body -->
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="sticky-footer">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Hệ Thống Bán Hàng & ERP Bán Lẻ &copy; HUFLIT SHOP @DateTime.Now.Year</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Toast Floating Alerts -->
    <div class="toast-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-lg alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-lg alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
        }
    </div>

    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Scripts Core -->
    <script src="~/Admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/Admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="~/Admin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Admin/js/sb-admin-2.min.js"></script>
    <script src="~/Admin/vendor/chart.js/Chart.min.js"></script>

    <!-- DataTables & Select2 -->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.3/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>

    <script>
        $(function () {
            $('.table:not(.no-datatable)').DataTable();
            $('.select2-enable, .select2-filter').select2({ width: '100%' });

            // Auto-hide alerts
            var alerts = $('.toast-container .alert');
            alerts.each(function () {
                var alert = $(this);
                setTimeout(function () {
                    alert.fadeTo(500, 0).slideUp(500, function () { $(this).remove(); });
                }, 4500);
            });
        });
    </script>

    <!-- SignalR for Real-time System Notifications -->
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        $(document).ready(function () {
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveSystemNotification", function (data) {
                try {
                    var audio = new Audio("https://assets.mixkit.co/active_storage/sfx/2869/2869-84.wav");
                    audio.play().catch(function(e) {});
                } catch (e) {}

                if (typeof swal === "function") {
                    swal({
                        title: data.title,
                        text: data.message,
                        icon: data.icon || "info",
                        button: "Đóng"
                    });
                } else {
                    alert(data.title + "\n" + data.message);
                }

                if (data.type === "NewOrder") {
                    window.dispatchEvent(new CustomEvent('NewOrderReceived', { detail: data }));
                }
            });

            connection.start().catch(function (err) {
                console.error("SignalR connection failed: ", err.toString());
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>