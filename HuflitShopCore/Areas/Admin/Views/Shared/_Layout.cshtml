    <script>
        // Auto-hide toast alerts
        $(document).ready(function () {
            // Tìm tất cả các alert trong toast container
            var alerts = $('.toast-container .alert');

            // Lặp qua từng alert và đặt thời gian tự động ẩn
            alerts.each(function () {
                var alert = $(this);
                setTimeout(function () {
                    alert.fadeTo(500, 0).slideUp(500, function () {
                        $(this).remove();
                    });
                }, 5000); // 5000ms = 5 giây
            });
        });
    </script>

