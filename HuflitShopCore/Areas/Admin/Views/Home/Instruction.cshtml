@{
    ViewData["Title"] = "Hướng dẫn vận hành hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --admin-ocean: #2563eb;
        --admin-cyan: #06b6d4;
        --admin-dark: #0f172a;
        --admin-bg: #f8fafc;
        --admin-card-border: #e2e8f0;
        --admin-gradient: linear-gradient(135deg, #2563eb 0%, #06b6d4 100%);
    }

    body {
        font-family: 'Jost', sans-serif;
        background-color: var(--admin-bg);
        color: var(--admin-dark);
    }

    /* Guide Banner */
    .guide-banner {
        background: #ffffff;
        border: 1px solid var(--admin-card-border);
        border-left: 4px solid var(--admin-ocean);
        padding: 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px -5px rgba(15, 23, 42, 0.04);
    }

    /* Step Section Box */
    .guide-box {
        background: #ffffff;
        border: 1px solid var(--admin-card-border);
        border-radius: 0.5rem;
        padding: 1.75rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px -5px rgba(15, 23, 42, 0.04);
    }

    .guide-step-title {
        font-size: 1.1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--admin-ocean);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--admin-card-border);
    }

    .guide-subbox {
        background: #f8fafc;
        border: 1px solid var(--admin-card-border);
        padding: 1.25rem;
        margin-top: 1rem;
    }

    /* Status Badges */
    .badge-status-guide {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        text-transform: uppercase;
        border-radius: 0;
    }
</style>

<div class="container-fluid pt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-dark font-weight-bold">
            <i class="fas fa-book-reader mr-2" style="color: var(--admin-ocean);"></i> Hướng Dẫn Vận Hành Hệ Thống A - Z
        </h1>
    </div>

    <!-- Rule Note Banner -->
    <div class="guide-banner">
        <h6 class="font-weight-bold text-dark mb-2"><i class="fas fa-lightbulb text-warning mr-2"></i>Quy Tắc Vận Hành Cốt Lõi</h6>
        <p class="mb-0 text-muted" style="line-height: 1.6;">
            Hãy khởi tạo dữ liệu từ các danh mục cơ sở trước (Danh mục, Kích thước, Màu sắc), sau đó mới tạo sản phẩm và biến thể. Hệ thống sử dụng cơ chế <b>Khóa / Mở khóa (Soft Delete)</b> để bảo vệ lịch sử đơn hàng và dữ liệu hóa đơn giao dịch.
        </p>
    </div>

    <div class="row">
        <!-- Main Steps Column -->
        <div class="col-lg-8">
            <!-- Step 1 -->
            <div class="guide-box">
                <div class="guide-step-title">
                    <i class="fas fa-database"></i> Bước 1: Thiết Lập Dữ Liệu Nền Tảng
                </div>
                <p class="text-muted">Trước khi tạo sản phẩm bán ra, bạn cần tạo trước các thông tin hỗ trợ cơ bản:</p>
                <ul class="text-muted">
                    <li><b>Danh mục:</b> Loại sản phẩm (Áo, Quần, Phụ kiện...).</li>
                    <li><b>Màu sắc & Kích thước:</b> Khai báo danh sách Size (S, M, L) và Màu (Đỏ, Đen, Xanh...).</li>
                    <li><b>Nhà cung cấp:</b> Thông tin các xưởng hoặc đơn vị cung ứng hàng.</li>
                </ul>
            </div>

            <!-- Step 2 -->
            <div class="guide-box">
                <div class="guide-step-title">
                    <i class="fas fa-tshirt"></i> Bước 2: Tạo Sản Phẩm & Biến Thể
                </div>
                <p class="text-muted">Ví dụ khởi tạo mẫu <b>"Áo Polo Thể Thao Nam"</b>:</p>

                <div class="guide-subbox">
                    <strong class="text-dark">Giai đoạn 2.1: Tạo vỏ sản phẩm</strong>
                    <ol class="mt-2 mb-0 text-muted">
                        <li>Vào menu <b>Sản phẩm</b> &rarr; Bấm <i>Thêm sản phẩm mới</i>.</li>
                        <li><b>Tên sản phẩm:</b> Nhập tên chi tiết rõ ràng.</li>
                        <li><b>Giá bán:</b> Nhập giá tiền bán niêm yết ngoài cửa hàng.</li>
                        <li><b>Mô tả:</b> Nhập chất liệu, kiểu dáng và hướng dẫn bảo quản.</li>
                    </ol>
                </div>

                <div class="guide-subbox">
                    <strong class="text-dark">Giai đoạn 2.2: Tạo Phân loại & Hình ảnh</strong>
                    <ol class="mt-2 mb-0 text-muted">
                        <li>Tìm sản phẩm vừa tạo trong danh sách &rarr; Chọn <b>Chi tiết</b>.</li>
                        <li>Bấm <b>Quản lý kho biến thể</b> để thêm từng cặp Size - Màu (VD: M-Đen, L-Đỏ...).</li>
                        <li>Chọn <b>Quản lý hình ảnh</b> để tải lên các góc chụp chân thực của sản phẩm.</li>
                    </ol>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="guide-box">
                <div class="guide-step-title">
                    <i class="fas fa-warehouse"></i> Bước 3: Nhập Kho Hàng
                </div>
                <p class="text-muted mb-0">Sản phẩm chỉ hiển thị bán ngoài Website khi có số lượng <b>Tồn kho > 0</b>. Vào menu <b>Quản lý Kho &rarr; Nhập kho</b>, chọn Nhà cung cấp và nhập số lượng tồn cho từng biến thể cụ thể.</p>
            </div>

            <!-- Step 4 & 5 -->
            <div class="guide-box">
                <div class="guide-step-title">
                    <i class="fas fa-headset"></i> Bước 4 & 5: Xử Lý Đơn Hàng & Tư Vấn Realtime
                </div>
                <ul class="text-muted mb-0">
                    <li class="mb-2"><b>Bán hàng & Khuyến mãi:</b> Thiết lập mã giảm giá để kích cầu người mua. Duyệt đơn hàng theo trình tự: Duyệt &rarr; Đóng gói &rarr; Đang giao &rarr; Hoàn thành.</li>
                    <li><b>Tư vấn SignalR:</b> Menu <i>Tư vấn khách hàng</i> hỗ trợ phản hồi tin nhắn trực tiếp ngoài website tức thì. Hệ thống sẽ có chuông báo hiệu khi có tin nhắn mới.</li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Rules Column -->
        <div class="col-lg-4">
            <!-- Lock vs Delete Rule -->
            <div class="guide-box" style="border-top: 3px solid #ef4444;">
                <h6 class="font-weight-bold text-danger text-uppercase mb-3"><i class="fas fa-lock mr-2"></i>Cơ Chế Khóa Dữ Liệu</h6>
                <p class="text-muted small" style="line-height: 1.6;">
                    Khi sản phẩm ngừng kinh doanh hoặc nhân viên nghỉ việc, hãy sử dụng tính năng <b>Khóa / Mở khóa</b> thay vì xóa hẳn.
                </p>
                <ul class="text-muted small pl-3 mb-0">
                    <li class="mb-2">Ẩn ngay lập tức khỏi gian hàng khách xem.</li>
                    <li class="mb-2">Bảo toàn nguyên vẹn lịch sử đơn hàng cũ.</li>
                    <li class="mb-0">Tránh lỗi dữ liệu liên kết trên hệ thống.</li>
                </ul>
            </div>

            <!-- Order Status Explanation -->
            <div class="guide-box" style="border-top: 3px solid #10b981;">
                <h6 class="font-weight-bold text-success text-uppercase mb-3"><i class="fas fa-tasks mr-2"></i>Trạng Thái Đơn Hàng</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><span class="badge badge-warning badge-status-guide">Chờ duyệt</span> Khách vừa tạo đơn</li>
                    <li class="mb-2"><span class="badge badge-info badge-status-guide">Đóng gói</span> Đang xuất kho</li>
                    <li class="mb-2"><span class="badge badge-primary badge-status-guide">Đang giao</span> Đã giao cho shipper</li>
                    <li class="mb-2"><span class="badge badge-success badge-status-guide">Hoàn thành</span> Đã giao & nhận tiền</li>
                    <li class="mb-0"><span class="badge badge-danger badge-status-guide">Đã hủy</span> Đơn bị hủy bỏ</li>
                </ul>
            </div>
        </div>
    </div>
</div>