@model IEnumerable<HuflitShopCore.Models.AdminSalaryStatisticViewModel>
@{
    ViewData["Title"] = "Thống Kê Lương Nhân Viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Thống Kê Bảng Lương</h1>
        <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm"><i class="fas fa-download fa-sm text-white-50"></i> Xuất Excel</button>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Tổng hợp lương tháng @ViewBag.Month/@ViewBag.Year</h6>
            <form method="get" class="form-inline">
                <select name="month" class="form-control mr-2 form-control-sm">
                    @for (int i = 1; i <= 12; i++)
                    {
                        if (i == ViewBag.Month)
                        {
                            <option value="@i" selected>Tháng @i</option>
                        }
                        else
                        {
                            <option value="@i">Tháng @i</option>
                        }
                    }
                </select>
                <select name="year" class="form-control mr-3 form-control-sm">
                    @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                    {
                        if (y == ViewBag.Year)
                        {
                            <option value="@y" selected>Năm @y</option>
                        }
                        else
                        {
                            <option value="@y">Năm @y</option>
                        }
                    }
                </select>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter"></i> Lọc</button>
            </form>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Nhân viên</th>
                            <th>Hệ số lương (VNĐ/Giờ)</th>
                            <th>Tổng giờ công</th>
                            <th>Tổng lương thực nhận</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.StaffName</strong><br/>
                                        <small class="text-muted">@item.StaffUserName</small>
                                    </td>
                                    <td>@item.HourlyRate.ToString("N0")</td>
                                    <td><strong class="text-info">@Math.Round(item.TotalHours, 2)h</strong></td>
                                    <td><strong class="text-success" style="font-size: 1.1rem;">@item.TotalSalary.ToString("N0") VNĐ</strong></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" title="In phiếu lương">
                                            <i class="fas fa-print"></i> In phiếu
                                        </button>
                                        <button class="btn btn-sm btn-outline-success" title="Chốt lương & Thanh toán">
                                            <i class="fas fa-check-double"></i> Đã trả
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Không có dữ liệu chấm công cho tháng này.</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model != null && Model.Any())
                    {
                        <tfoot class="bg-light">
                            <tr>
                                <th colspan="2" class="text-right">TỔNG CỘNG:</th>
                                <th>@Math.Round(Model.Sum(x => x.TotalHours), 2)h</th>
                                <th colspan="2" class="text-danger" style="font-size:1.2rem;">@Model.Sum(x => x.TotalSalary).ToString("N0") VNĐ</th>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Biểu đồ cường độ làm việc -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Biểu đồ cường độ làm việc (Tổng giờ công/tháng)</h6>
            </div>
            <div class="card-body">
                <div class="chart-bar" style="height: 350px;">
                    <canvas id="salaryChart"></canvas>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model != null && Model.Any())
        {
            <text>
            var ctx = document.getElementById("salaryChart");
            if (ctx) {
                var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => x.StaffName)));
                var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => Math.Round(x.TotalHours, 2))));
                
                var myBarChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: "Tổng giờ công",
                            backgroundColor: "#4e73df",
                            hoverBackgroundColor: "#2e59d9",
                            borderColor: "#4e73df",
                            data: data,
                        }],
                    },
                    options: {
                        maintainAspectRatio: false,
                        layout: {
                            padding: { left: 10, right: 25, top: 25, bottom: 0 }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Số giờ làm'
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
            </text>
        }
    </script>
}
