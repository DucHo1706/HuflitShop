@model int
@{
    ViewData["Title"] = "Thống kê doanh thu BI";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var monthlyRevenue = ViewBag.MonthlyRevenue as decimal[];
    var quarterlyRevenue = ViewBag.QuarterlyRevenue as decimal[];
    var seasonalRevenue = ViewBag.SeasonalRevenue as Dictionary<string, decimal>;
    var topProducts = ViewBag.TopProducts as List<KeyValuePair<string, int>>;
    var yearlyComparison = ViewBag.YearlyComparison as Dictionary<int, decimal>;
    bool isMockData = ViewBag.IsMockData ?? false;
}

<style>
    /* Premium BI Styles */
    .report-card {
        border: 1px solid var(--admin-border, #e2e8f0);
        border-radius: 0.75rem;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .report-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -10px rgba(15, 23, 42, 0.08) !important;
        }

    .kpi-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    /* Tabs Styling */
    .custom-nav-pills {
        background: #f1f5f9;
        padding: 0.35rem;
        border-radius: 0.65rem;
        border: 1px solid #e2e8f0;
    }

        .custom-nav-pills .nav-link {
            border-radius: 0.5rem;
            color: #64748b;
            font-weight: 600;
            font-size: 0.875rem;
            padding: 0.75rem 1rem;
            transition: all 0.2s ease;
            border: none !important;
        }

            .custom-nav-pills .nav-link.active {
                background: #ffffff !important;
                color: #2563eb !important;
                box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            }

    /* Ranking Table Styling */
    .rank-badge {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 700;
        font-size: 0.75rem;
    }

    .rank-1 {
        background: #fef3c7;
        color: #d97706;
    }

    .rank-2 {
        background: #e0f2fe;
        color: #0284c7;
    }

    .rank-3 {
        background: #f1f5f9;
        color: #475569;
    }

    .rank-other {
        background: #f8fafc;
        color: #94a3b8;
    }
</style>

<div class="container-fluid py-2">

    <!-- Page Header & Year Filter -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-dark font-weight-bold" style="letter-spacing: -0.5px;">
                <i class="fas fa-chart-line text-primary mr-2"></i>Thống Kê Doanh Thu BI
            </h1>
            <p class="text-muted small mb-0">Báo cáo phân tích doanh thu & hiệu suất kinh doanh năm <strong>@Model</strong></p>
        </div>

        <form method="get" class="form-inline mt-3 mt-sm-0">
            <div class="input-group shadow-sm" style="border-radius: 0.5rem; overflow: hidden;">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-white border-right-0 text-muted small font-weight-bold">
                        <i class="far fa-calendar-alt mr-1 text-primary"></i> Kỳ báo cáo:
                    </span>
                </div>
                <select name="year" class="form-control form-control-sm border-left-0 font-weight-bold text-dark" onchange="this.form.submit()" style="height: 38px;">
                    @for (int y = DateTime.Now.Year - 4; y <= DateTime.Now.Year; y++)
                    {
                        if (y == Model)
                        {
                            <option value="@y" selected>Năm @y</option>
                        }
                        else
                        {
                            <option value="@y">Năm @y</option>
                        }
                    }
                </select>
            </div>
        </form>
    </div>

    <!-- Alert for Mock Data Simulation -->
    @if (isMockData)
    {
        <div class="alert border-0 shadow-sm mb-4" role="alert" style="background: #fffbeb; border-left: 4px solid #f59e0b !important; border-radius: 0.5rem;">
            <div class="d-flex align-items-center">
                <div class="mr-3 text-warning">
                    <i class="fas fa-magic fa-2x"></i>
                </div>
                <div>
                    <h6 class="font-weight-bold text-dark mb-1">Chế độ mô phỏng dữ liệu thông minh đang bật</h6>
                    <p class="mb-0 text-muted small">
                        Do cơ sở dữ liệu hệ thống hiện có ít hơn 5 đơn hàng hoàn tất, ERP đã kích hoạt thuật toán tạo mẫu doanh thu kinh doanh giả lập để hiển thị đầy đủ trực quan hóa biểu đồ. Dữ liệu thực tế sẽ tự động ghi đè ngay khi cửa hàng phát sinh đủ giao dịch.
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Top KPI Cards Row -->
    <div class="row mb-4">

        <!-- Tổng doanh thu năm -->
        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card report-card shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase text-muted mb-1" style="letter-spacing: 0.5px;">Tổng doanh thu năm @Model</div>
                            <div class="h3 mb-0 font-weight-bold text-dark">
                                @(monthlyRevenue?.Sum().ToString("N0") ?? "0") <small class="text-muted font-weight-normal" style="font-size: 0.9rem;">VNĐ</small>
                            </div>
                        </div>
                        <div class="kpi-icon-box" style="background: #eff6ff; color: #2563eb;">
                            <i class="fas fa-wallet"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mùa đạt doanh thu cao nhất -->
        @if (seasonalRevenue != null && seasonalRevenue.Any())
        {
            var topSeason = seasonalRevenue.OrderByDescending(kv => kv.Value).First();
            <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
                <div class="card report-card shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-xs font-weight-bold text-uppercase text-muted mb-1" style="letter-spacing: 0.5px;">Mùa cao điểm kinh doanh</div>
                                <div class="h3 mb-0 font-weight-bold text-dark">
                                    @topSeason.Key
                                </div>
                            </div>
                            <div class="kpi-icon-box" style="background: #ecfdf5; color: #10b981;">
                                <i class="fas fa-cloud-sun"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Top 5 Sản phẩm bán ra -->
        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card report-card shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase text-muted mb-1" style="letter-spacing: 0.5px;">Sản phẩm tiêu thụ (Top 5)</div>
                            <div class="h3 mb-0 font-weight-bold text-dark">
                                @(topProducts?.Sum(p => p.Value) ?? 0) <small class="text-muted font-weight-normal" style="font-size: 0.9rem;">sản phẩm</small>
                            </div>
                        </div>
                        <div class="kpi-icon-box" style="background: #ecfeff; color: #06b6d4;">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Navigation Tabs -->
    <ul class="nav custom-nav-pills nav-justified mb-4" id="reportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="month-tab" data-bs-toggle="tab" data-bs-target="#month" type="button" role="tab" aria-controls="month" aria-selected="true">
                <i class="fas fa-chart-area mr-2"></i>Doanh Thu Theo Tháng & Quý
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="season-tab" data-bs-toggle="tab" data-bs-target="#season" type="button" role="tab" aria-controls="season" aria-selected="false">
                <i class="fas fa-chart-bar mr-2"></i>Cơ Cấu Mùa & So Sánh Năm
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="product-tab" data-bs-toggle="tab" data-bs-target="#product" type="button" role="tab" aria-controls="product" aria-selected="false">
                <i class="fas fa-award mr-2"></i>Top Sản Phẩm Bán Chạy
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="reportTabsContent">

        <!-- TAB 1: Tháng & Quý -->
        <div class="tab-pane fade show active" id="month" role="tabpanel" aria-labelledby="month-tab">
            <div class="row">
                <!-- Line Chart: 12 Tháng -->
                <div class="col-xl-8 col-lg-7 mb-4">
                    <div class="card report-card shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 py-3 d-flex align-items-center justify-content-between">
                            <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-chart-line text-primary mr-2"></i>Biến động Doanh thu 12 tháng năm @Model</h6>
                            <span class="badge badge-light text-muted border">Đơn vị: VNĐ</span>
                        </div>
                        <div class="card-body">
                            <div class="chart-area" style="position: relative; height: 340px;">
                                <canvas id="monthlyRevenueChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Doughnut Chart: Theo Quý -->
                <div class="col-xl-4 col-lg-5 mb-4">
                    <div class="card report-card shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-chart-pie text-cyan mr-2" style="color: #06b6d4;"></i>Tỷ trọng Doanh thu theo Quý</h6>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div class="chart-pie pt-2" style="position: relative; height: 250px;">
                                <canvas id="quarterlyRevenueChart"></canvas>
                            </div>
                            <div class="mt-3 text-center small font-weight-bold">
                                <span class="mr-3"><i class="fas fa-circle mr-1" style="color: #0f172a;"></i> Quý I</span>
                                <span class="mr-3"><i class="fas fa-circle mr-1" style="color: #2563eb;"></i> Quý II</span>
                                <span class="mr-3"><i class="fas fa-circle mr-1" style="color: #06b6d4;"></i> Quý III</span>
                                <span><i class="fas fa-circle mr-1" style="color: #f59e0b;"></i> Quý IV</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: Mùa & So sánh Năm -->
        <div class="tab-pane fade" id="season" role="tabpanel" aria-labelledby="season-tab">
            <div class="row">
                <!-- Bar Chart: 4 Mùa -->
                <div class="col-xl-6 col-lg-6 mb-4">
                    <div class="card report-card shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-sun text-warning mr-2"></i>Doanh thu theo 4 Mùa thời trang năm @Model</h6>
                        </div>
                        <div class="card-body">
                            <div class="chart-bar" style="position: relative; height: 340px;">
                                <canvas id="seasonalRevenueChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bar Chart: So sánh các năm -->
                <div class="col-xl-6 col-lg-6 mb-4">
                    <div class="card report-card shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-history text-primary mr-2"></i>So sánh Doanh thu các năm gần đây</h6>
                        </div>
                        <div class="card-body">
                            <div class="chart-bar" style="position: relative; height: 340px;">
                                <canvas id="yearlyComparisonChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: Sản phẩm bán chạy -->
        <div class="tab-pane fade" id="product" role="tabpanel" aria-labelledby="product-tab">
            <div class="card report-card shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-crown text-warning mr-2"></i>Top 5 Sản phẩm đạt doanh số tốt nhất năm @Model</h6>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-lg-6 mb-4 mb-lg-0">
                            <div class="chart-bar" style="position: relative; height: 320px;">
                                <canvas id="topProductsChart"></canvas>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="border-collapse: separate; border-spacing: 0 8px;">
                                    <thead>
                                        <tr class="text-muted text-uppercase small">
                                            <th style="border: none;" class="text-center">Thứ hạng</th>
                                            <th style="border: none;">Tên Sản phẩm</th>
                                            <th style="border: none;" class="text-right">Đã bán</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (topProducts != null && topProducts.Any())
                                        {
                                            int rank = 1;
                                            foreach (var kv in topProducts)
                                            {
                                                <tr class="bg-light rounded">
                                                    <td class="text-center" style="border: none; border-radius: 0.5rem 0 0 0.5rem;">
                                                        <span class="rank-badge @(rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "rank-other")">@rank</span>
                                                    </td>
                                                    <td class="font-weight-bold text-dark" style="border: none;">@kv.Key</td>
                                                    <td class="text-right font-weight-bold text-primary" style="border: none; border-radius: 0 0.5rem 0.5rem 0;">@kv.Value cái</td>
                                                </tr>
                                                rank++;
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu bán sản phẩm trong kỳ báo cáo này.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <!-- CDN Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Data Serialization from C# Razor
        var monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyRevenue));
        var quarterlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(quarterlyRevenue));
        var seasonalLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(seasonalRevenue?.Keys.ToList() ?? new List<string>()));
        var seasonalValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(seasonalRevenue?.Values.ToList() ?? new List<decimal>()));
        var yearlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(yearlyComparison?.Keys.Select(k => "Năm " + k).ToList() ?? new List<string>()));
        var yearlyValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(yearlyComparison?.Values.ToList() ?? new List<decimal>()));
        var topProductNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topProducts?.Select(p => p.Key).ToList() ?? new List<string>()));
        var topProductQuantities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topProducts?.Select(p => p.Value).ToList() ?? new List<int>()));

        // Chart Font Style Override matching Jost / Modern ERP Font
        Chart.defaults.font.family = 'Jost, -apple-system, sans-serif';
        Chart.defaults.color = '#64748b';

        // 1. Monthly Revenue Chart (Line Chart with Ocean Royal theme)
        var ctxLine = document.getElementById('monthlyRevenueChart').getContext('2d');
        var monthlyRevenueChart = new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T10", "T11", "T12"],
                datasets: [{
                    label: "Doanh thu (VNĐ)",
                    tension: 0.35,
                    backgroundColor: "rgba(37, 99, 235, 0.08)",
                    borderColor: "#2563eb",
                    borderWidth: 2.5,
                    pointRadius: 4,
                    pointBackgroundColor: "#2563eb",
                    pointBorderColor: "#ffffff",
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: "#2563eb",
                    pointHoverBorderColor: "#ffffff",
                    pointBorderWidth: 2,
                    fill: true,
                    data: monthlyData,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return 'Doanh thu: ' + context.parsed.y.toLocaleString() + ' VNĐ';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function (value) { return (value / 1000000).toLocaleString() + 'M'; }
                        }
                    }
                }
            }
        });

        // 2. Quarterly Revenue Chart (Doughnut Chart with Luxury Tech Palette)
        var ctxPie = document.getElementById('quarterlyRevenueChart').getContext('2d');
        var quarterlyRevenueChart = new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: ["Quý I", "Quý II", "Quý III", "Quý IV"],
                datasets: [{
                    data: quarterlyData,
                    backgroundColor: ['#0f172a', '#2563eb', '#06b6d4', '#f59e0b'],
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                cutout: '72%'
            }
        });

        // 3. Seasonal Revenue Chart (Bar Chart)
        var ctxSeasonal = document.getElementById('seasonalRevenueChart').getContext('2d');
        var seasonalRevenueChart = new Chart(ctxSeasonal, {
            type: 'bar',
            data: {
                labels: seasonalLabels,
                datasets: [{
                    label: "Doanh thu (VNĐ)",
                    backgroundColor: ["#0284c7", "#f59e0b", "#f97316", "#2563eb"],
                    borderRadius: 6,
                    data: seasonalValues,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function (value) { return (value / 1000000).toLocaleString() + 'Mđ'; }
                        }
                    }
                }
            }
        });

        // 4. Yearly Comparison Chart (Bar Chart)
        var ctxYearly = document.getElementById('yearlyComparisonChart').getContext('2d');
        var yearlyComparisonChart = new Chart(ctxYearly, {
            type: 'bar',
            data: {
                labels: yearlyLabels,
                datasets: [{
                    label: "Doanh thu (VNĐ)",
                    backgroundColor: "rgba(37, 99, 235, 0.85)",
                    hoverBackgroundColor: "#0f172a",
                    borderRadius: 6,
                    data: yearlyValues,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function (value) { return (value / 1000000).toLocaleString() + 'Mđ'; }
                        }
                    }
                }
            }
        });

        // 5. Top Products Chart (Horizontal Bar Chart)
        var ctxBar = document.getElementById('topProductsChart').getContext('2d');
        var topProductsChart = new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: topProductNames.map(name => name.length > 22 ? name.substring(0, 20) + '...' : name),
                datasets: [{
                    label: "Số lượng đã bán",
                    backgroundColor: "#06b6d4",
                    hoverBackgroundColor: "#2563eb",
                    borderRadius: 6,
                    data: topProductQuantities,
                }],
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: '#f1f5f9' } },
                    y: { grid: { display: false } }
                }
            }
        });
    </script>
}