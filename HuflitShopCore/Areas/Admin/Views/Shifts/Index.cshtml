@model IEnumerable<HuflitShopCore.Models.Shift>
@{
    ViewData["Title"] = "Quản lý Ca làm việc";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Quản lý Ca làm việc (Shifts)</h1>
        <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Tạo ca mới
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Tên Ca</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Số NV tối đa</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td><span class="badge badge-info text-uppercase" style="font-size:14px;">@item.Name</span></td>
                                <td>@item.StartTime.ToString(@"hh\:mm")</td>
                                <td>@item.EndTime.ToString(@"hh\:mm")</td>
                                <td>@item.MaxStaff</td>
                                <td>
                                    @if(item.IsActive) {
                                        <span class="badge badge-success">Đang dùng</span>
                                    } else {
                                        <span class="badge badge-secondary">Tạm ngưng</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm mr-2" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('CẢNH BÁO: Xóa ca làm việc này sẽ xóa TOÀN BỘ lịch sử đăng ký, bảng phân ca, điểm danh và đơn từ liên quan đến ca này! Bạn có chắc chắn muốn xóa?');">
                                            <button type="submit" class="btn btn-danger btn-circle btn-sm" title="Xóa toàn bộ">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
