@model HuflitShopCore.DTOs.ForgotPasswordDTO
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_LayoutLogin";
}

<style>
    .title-uiverse {
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        margin: 0 0 8px 0;
        font-size: 26px;
        font-weight: 800;
        color: #000;
    }

    .sub-title-uiverse {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .form-uiverse {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 15px;
    }

    .input-uiverse {
        border-radius: 20px;
        border: 1px solid #c0c0c0;
        outline: 0 !important;
        box-sizing: border-box;
        padding: 12px 15px;
        width: 100%;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        font-size: 13px;
        transition: border-color 0.2s;
    }

        .input-uiverse:focus {
            border-color: teal;
        }

    .form-btn {
        padding: 12px 15px;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        border-radius: 20px;
        border: 0 !important;
        outline: 0 !important;
        background: teal;
        color: white;
        cursor: pointer;
        box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
        font-weight: 700;
        font-size: 12px;
        transition: all 0.2s ease;
        width: 100%;
        text-align: center;
        text-decoration: none !important;
        display: block;
    }

        .form-btn:hover {
            background: #006666;
            color: white;
        }

    .sign-up-label {
        margin: 15px 0 0 0;
        font-size: 11px;
        color: #747474;
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    }

    .sign-up-link {
        margin-left: 4px;
        font-size: 11px;
        text-decoration: underline;
        text-decoration-color: teal;
        color: teal;
        cursor: pointer;
        font-weight: 800;
    }

    .auth-error-box {
        font-size: 11px;
        color: #d9534f;
        margin-bottom: 12px;
        font-family: sans-serif;
    }
</style>

@if (Model?.EmailSent == true)
{
    <div style="text-align:center;">
        <i class="fas fa-paper-plane" style="font-size: 48px; color: teal; margin-bottom: 12px;"></i>
        <p class="title-uiverse">Email Đã Gửi!</p>
        <p class="sub-title-uiverse">
            Chúng tôi đã gửi đường dẫn đặt lại mật khẩu đến email của bạn. Vui lòng kiểm tra hộp thư (kể cả thư rác).
        </p>
        <a asp-action="Login" asp-controller="Login" class="form-btn">
            Quay về đăng nhập
        </a>
    </div>
}
else
{
    <p class="title-uiverse">Quên Mật Khẩu</p>
    <p class="sub-title-uiverse">Nhập địa chỉ email đăng ký để nhận liên kết đặt lại mật khẩu</p>

    <form class="form-uiverse" asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error-box">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <div>
            <input asp-for="Email" type="email" class="input-uiverse" placeholder="Địa chỉ Email của bạn..." required autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="form-btn">Gửi email đặt lại</button>
    </form>

    <p class="sign-up-label">
        Nhớ ra mật khẩu?
        <a asp-action="Login" asp-controller="Login" class="sign-up-link">Đăng nhập ngay</a>
    </p>
}