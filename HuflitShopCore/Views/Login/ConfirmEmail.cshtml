@model HuflitShopCore.DTOs.EmailConfirmDTO
@{
    ViewData["Title"] = "Xác thực Email";
    Layout = "_LayoutLogin";
}

<style>
    .title-uiverse {
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        margin: 0 0 10px 0;
        font-size: 24px;
        font-weight: 800;
        color: #000;
    }

    .sub-title-uiverse {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .form-btn {
        padding: 12px 15px;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        border-radius: 20px;
        border: 0 !important;
        outline: 0 !important;
        background: teal;
        color: white;
        cursor: pointer;
        box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
        font-weight: 700;
        font-size: 12px;
        transition: all 0.2s ease;
        width: 100%;
        text-align: center;
        text-decoration: none !important;
        display: block;
    }

        .form-btn:hover {
            background: #006666;
            color: white;
        }

    .auth-error-box {
        font-size: 11px;
        color: #d9534f;
        margin-bottom: 12px;
        font-family: sans-serif;
    }
</style>

<p class="title-uiverse">Xác Thực Email</p>

@if (Model.EmailVerified == true)
{
    <div style="text-align: center; margin-bottom: 20px;">
        <i class="fas fa-check-circle" style="font-size: 48px; color: teal; margin-bottom: 12px;"></i>
        <p class="sub-title-uiverse">
            Email của bạn đã được xác thực thành công. Bạn đã có thể bắt đầu mua sắm ngay bây giờ!
        </p>
    </div>
    <a asp-controller="Login" asp-action="Login" class="form-btn">
        Tiến hành đăng nhập
    </a>
}
else
{
    if (Model.EmailSent)
    {
        <p class="sub-title-uiverse">
            Chúng tôi đã gửi link xác thực đến email của bạn. Vui lòng kiểm tra hộp thư (kể cả hộp thư rác).
        </p>
    }
    else
    {
        <p class="sub-title-uiverse">
            Một email xác thực đã được gửi đến tài khoản của bạn. Vui lòng nhấp vào liên kết trong email để kích hoạt.
        </p>
    }

    <form asp-action="ConfirmEmail" method="post">
        @Html.AntiForgeryToken()
        <div class="auth-error-box">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
        <input type="hidden" asp-for="Email" />

        <p class="sub-title-uiverse" style="margin-bottom: 12px; font-weight: 600;">
            Không nhận được email hoặc liên kết bị hết hạn?
        </p>
        <button type="submit" class="form-btn">
            Gửi lại email xác thực
        </button>
    </form>
}