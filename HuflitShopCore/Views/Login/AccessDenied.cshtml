@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Từ chối truy cập";
}

<style>
    .title-uiverse {
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        margin: 0 0 10px 0;
        font-size: 24px;
        font-weight: 800;
        color: #d9534f;
    }

    .sub-title-uiverse {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .form-btn-danger {
        padding: 12px 15px;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        border-radius: 20px;
        border: 0 !important;
        outline: 0 !important;
        background: #d9534f;
        color: white;
        cursor: pointer;
        box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
        font-weight: 700;
        font-size: 12px;
        transition: all 0.2s ease;
        width: 100%;
        text-align: center;
        text-decoration: none !important;
        display: block;
    }

        .form-btn-danger:hover {
            background: #c9302c;
            color: white;
        }

    .btn-secondary-uiverse {
        border-radius: 20px;
        box-sizing: border-box;
        padding: 10px 15px;
        box-shadow: rgba(0, 0, 0, 0.16) 0px 10px 36px 0px, rgba(0, 0, 0, 0.06) 0px 0px 0px 1px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        font-size: 12px;
        background-color: #fff;
        border: 2px solid #747474;
        color: #333;
        text-decoration: none !important;
        font-weight: 700;
        width: 100%;
    }

        .btn-secondary-uiverse:hover {
            background-color: #f8f9fa;
            color: #000;
        }
</style>

<div class="text-center" style="text-align: center;">
    <div style="font-size: 50px; color: #d9534f; margin-bottom: 12px;">
        <i class="fas fa-shield-alt"></i>
    </div>

    <p class="title-uiverse">Từ Chối Truy Cập</p>

    <p class="sub-title-uiverse">
        Tài khoản của bạn không có quyền truy cập vào khu vực này (Admin / Nhân viên). Vui lòng quay lại trang chủ hoặc đăng nhập bằng tài khoản khác.
    </p>

    <div style="display: flex; flex-direction: column; gap: 12px;">
        <a asp-controller="Home" asp-action="Index" class="form-btn-danger">
            Quay lại Trang chủ
        </a>
        <a asp-controller="Login" asp-action="Logout" class="btn-secondary-uiverse">
            Đăng nhập tài khoản khác
        </a>
    </div>
</div>