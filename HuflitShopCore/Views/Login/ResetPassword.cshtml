@model HuflitShopCore.DTOs.ResetPasswordDTO
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_LayoutLogin";
}

<style>
    .title-uiverse {
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        margin: 0 0 8px 0;
        font-size: 26px;
        font-weight: 800;
        color: #000;
    }

    .sub-title-uiverse {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .form-uiverse {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 15px;
    }

    .input-uiverse {
        border-radius: 20px;
        border: 1px solid #c0c0c0;
        outline: 0 !important;
        box-sizing: border-box;
        padding: 12px 15px;
        width: 100%;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        font-size: 13px;
        transition: border-color 0.2s;
    }

    .input-uiverse:focus {
        border-color: teal;
    }

    .form-btn {
        padding: 12px 15px;
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        border-radius: 20px;
        border: 0 !important;
        outline: 0 !important;
        background: teal;
        color: white;
        cursor: pointer;
        box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
        font-weight: 700;
        font-size: 12px;
        transition: all 0.2s ease;
        width: 100%;
        text-align: center;
        text-decoration: none !important;
        display: block;
    }

    .form-btn:hover {
        background: #006666;
        color: white;
    }

    .auth-error-box {
        font-size: 11px;
        color: #d9534f;
        margin-bottom: 12px;
        font-family: sans-serif;
    }
</style>

@if (Model?.IsSuccess == true)
{
    <div style="text-align: center;">
        <i class="fas fa-check-circle" style="font-size: 48px; color: teal; margin-bottom: 12px;"></i>
        <p class="title-uiverse">Thành Công!</p>
        <p class="sub-title-uiverse">
            Bạn đã cập nhật mật khẩu mới thành công. Hãy đăng nhập lại để tiếp tục sử dụng.
        </p>
        <a asp-controller="Login" asp-action="Login" class="form-btn">
            Tiến hành đăng nhập
        </a>
    </div>
}
else
{
    <p class="title-uiverse">Đặt Lai Mật Khẩu</p>
    <p class="sub-title-uiverse">Tạo mật khẩu mới cho tài khoản của bạn</p>

    <form class="form-uiverse" asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error-box">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div>
            <input asp-for="NewPassword" type="password" class="input-uiverse" placeholder="Mật khẩu mới (Tối thiểu 6 ký tự)" required autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div>
            <input asp-for="ConfirmNewPassword" type="password" class="input-uiverse" placeholder="Xác nhận mật khẩu mới" required autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="form-btn" style="margin-top: 5px;">
            Cập nhật mật khẩu
        </button>
    </form>
}