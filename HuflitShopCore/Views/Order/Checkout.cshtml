@model HuflitShopCore.Models.Address
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh toán đơn hàng";

    decimal total = ViewBag.Total is decimal d ? d : 0m;
    decimal shippingFee = ViewBag.ShippingFee is decimal sf ? sf : 0m;
    var cartItems = ViewBag.CartItems as List<HuflitShopCore.Models.Cart> ?? new List<HuflitShopCore.Models.Cart>();
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet">

<style>
    :root {
        --font-heading: 'Playfair Display', serif;
        --font-body: 'Jost', sans-serif;
        --color-primary: #1c1c1c;
        --color-gold: #c5a059;
        --color-bg: #faf9f6;
        --color-blue: #0033ff;
        --color-border: #e2e8f0;
        --transition-slow: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    body {
        font-family: var(--font-body);
        background-color: var(--color-bg);
        color: var(--color-primary);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
    }

    .checkout-container {
        max-width: 1280px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
    }

    /* Page Header Banner */
    .checkout-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .checkout-header__title {
        font-size: 2.5rem;
        font-weight: 600;
        color: var(--color-primary);
    }

    .checkout-header__line {
        width: 60px;
        height: 1px;
        background: var(--color-gold);
        margin: 1rem auto 0 auto;
    }

    /* Progress Steps */
    .steps-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #ffffff;
        padding: 1.25rem 2rem;
        border: 1px solid var(--color-border);
        border-top: 3px solid var(--color-gold);
        margin-bottom: 2rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.02);
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 500;
        color: #94a3b8;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

        .step-item.active {
            color: var(--color-primary);
            font-weight: 700;
        }

    .step-num {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background-color: #f1f5f9;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 700;
        border: 1px solid var(--color-border);
    }

    .step-item.active .step-num {
        background: var(--color-blue);
        color: #ffffff;
        border-color: var(--color-blue);
    }

    /* Luxury Cards */
    .checkout-card {
        background: #ffffff;
        border: 1px solid var(--color-border);
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.02);
        transition: var(--transition-slow);
    }

        .checkout-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
        }

    .checkout-card-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--color-primary);
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }

        .checkout-card-header i {
            color: var(--color-gold);
        }

    /* Form Inputs */
    .form-control-modern {
        border-radius: 0 !important;
        border: 1px solid var(--color-border);
        font-size: 0.95rem;
        padding: 10px 14px;
        background: #faf9f6;
        transition: var(--transition-slow);
    }

        .form-control-modern:focus {
            border-color: var(--color-blue);
            background: #ffffff;
            box-shadow: none;
        }

    /* Address Autocomplete */
    .address-autocomplete {
        position: relative;
    }

    .address-suggestions {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid var(--color-border);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .address-suggestion-item {
        display: block;
        width: 100%;
        padding: 0.75rem 1rem;
        border: 0;
        border-bottom: 1px solid #f1f5f9;
        background: #fff;
        color: var(--color-primary);
        text-align: left;
        cursor: pointer;
        font-size: 0.9rem;
    }

        .address-suggestion-item:hover {
            background: #f0f9ff;
            color: var(--color-blue);
        }

    /* Payment & Shipping Option Cards */
    .option-card {
        border: 1px solid var(--color-border);
        padding: 1.25rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: var(--transition-slow);
        margin-bottom: 1rem;
        background: #faf9f6;
    }

        .option-card:hover {
            border-color: var(--color-gold);
            background: #ffffff;
        }

        .option-card.selected {
            border-color: var(--color-blue);
            background-color: #ffffff;
            box-shadow: 0 4px 15px rgba(0, 51, 255, 0.08);
        }

    /* Luxury Buttons */
    .btn-luxury-primary {
        display: block;
        width: 100%;
        padding: 14px;
        background: var(--color-primary);
        color: #ffffff;
        border: none;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: var(--transition-slow);
        text-align: center;
        cursor: pointer;
    }

        .btn-luxury-primary:hover {
            background: var(--color-blue);
            color: #ffffff;
            box-shadow: 0 6px 20px rgba(0, 51, 255, 0.25);
        }

    .btn-luxury-outline {
        display: inline-block;
        padding: 8px 18px;
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.8rem;
        transition: var(--transition-slow);
        cursor: pointer;
    }

        .btn-luxury-outline:hover {
            background: var(--color-primary);
            color: #ffffff;
        }

    /* Sticky Summary */
    .summary-section {
        background: #ffffff;
        padding: 2rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        position: sticky;
        top: 100px;
        border: 1px solid var(--color-border);
        border-top: 3px solid var(--color-gold);
    }

    /* Voucher Ticket */
    .voucher-ticket {
        display: flex;
        background: #fff;
        border: 1px solid var(--color-border);
        margin-bottom: 12px;
        transition: var(--transition-slow);
    }

        .voucher-ticket:hover:not(.disabled) {
            border-color: var(--color-blue);
            transform: translateY(-2px);
        }

        .voucher-ticket.disabled {
            opacity: 0.55; 
            filter: grayscale(80%);
            cursor: not-allowed;
            box-shadow: none !important;
        }

            .voucher-ticket.disabled .btn-apply-click {
                pointer-events: none;
                background-color: #f1f5f9 !important; 
                color: #94a3b8 !important;
                border-color: #e2e8f0 !important; 
            }
    .voucher-left {
        width: 30%;
        background: var(--color-primary);
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 10px;
        font-size: 0.85rem;
    }

        .voucher-left i {
            color: var(--color-gold);
            font-size: 1.3rem;
            margin-bottom: 4px;
        }

    .voucher-right {
        width: 70%;
        padding: 12px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
    }

    .voucher-subtitle .badge {
        white-space: normal !important; /* Cho phép text tự động xuống dòng khi hết chỗ */
        text-align: left; /* Căn trái văn bản để dễ đọc hơn */
        line-height: 1.5; /* Tạo khoảng cách dòng thoáng, sang trọng */
        display: inline-block;
        max-width: 100%; /* Ép chiều rộng tối đa vừa vặn với vùng chứa */
        padding: 6px 8px; /* Tăng đệm xung quanh chữ cho khối badge đẹp hơn */
    }
</style>

<div class="checkout-header" data-aos="fade-up">
    <h1 class="checkout-header__title">Thanh Toán Đơn Hàng</h1>
    <div class="checkout-header__line"></div>
</div>

<div class="checkout-container">
    <div class="steps-container" data-aos="fade-up">
        <h5 class="mb-0 font-weight-bold text-uppercase" style="font-family: var(--font-heading); letter-spacing: 1px;">
            <i class="fas fa-shopping-bag mr-2" style="color: var(--color-gold);"></i>Quy trình đặt hàng
        </h5>
        <div class="d-flex gap-4 d-none d-md-flex">
            <div class="step-item"><span class="step-num"><i class="fas fa-check"></i></span> Giỏ hàng</div>
            <div class="step-item active"><span class="step-num">2</span> Đặt hàng</div>
            <div class="step-item"><span class="step-num">3</span> Thành công</div>
        </div>
    </div>

    <form asp-action="PlaceOrder" asp-controller="Order" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="appliedPromoCode" id="appliedPromoCode" value="" />
        <input type="hidden" name="buyNowVariantId" id="buyNowVariantId" value="@ViewBag.BuyNowVariantId" />
        <input type="hidden" name="buyNowQty" id="buyNowQty" value="@ViewBag.BuyNowQty" />
        <input type="hidden" id="shippingFeeInput" value="@shippingFee" />
        <input type="hidden" name="shippingServiceId" id="shippingServiceId" value="0" />
        <input type="hidden" name="shippingServiceTypeId" id="shippingServiceTypeId" value="0" />

        <div class="row">
            <div class="col-lg-8">
                <!-- Thông tin nhận hàng -->
                <div class="checkout-card" data-aos="fade-up">
                    <div class="checkout-card-header">
                        <i class="fas fa-map-marker-alt"></i> Thông Tin Nhận Hàng
                    </div>

                    <div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold small"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="shippingFullName" class="form-label text-uppercase small font-weight-bold">Họ và tên</label>
                                <input type="text" name="shippingFullName" id="shippingFullName" class="form-control form-control-modern" value="@(User.FindFirst("Name")?.Value)" placeholder="Nhập họ và tên..." required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="shippingPhoneNumber" class="form-label text-uppercase small font-weight-bold">Số điện thoại</label>
                                <input type="text" name="shippingPhoneNumber" id="shippingPhoneNumber" class="form-control form-control-modern" value="@(User.FindFirst("Phone")?.Value)" placeholder="Nhập số điện thoại..." required />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label asp-for="SpecificAddress" class="form-label text-uppercase small font-weight-bold">Địa chỉ cụ thể</label>
                                <div class="address-autocomplete">
                                    <input asp-for="SpecificAddress" class="form-control form-control-modern" placeholder="Ví dụ: 828 Sư Vạn Hạnh" autocomplete="off" />
                                    <div id="addressSuggestions" class="address-suggestions" role="listbox" hidden></div>
                                </div>
                                <small id="addressSuggestionHelp" class="form-text text-muted">Chọn Tỉnh/Quận/Phường trước, sau đó nhập số nhà để gợi ý.</small>
                                <span asp-validation-for="SpecificAddress" class="text-danger small font-weight-bold mt-1"></span>
                            </div>
                        </div>
                        <input asp-for="City" type="hidden" id="City" />
                        <input asp-for="ProvinceId" type="hidden" id="ProvinceId" />
                        <input asp-for="District" type="hidden" id="District" />
                        <input asp-for="DistrictId" type="hidden" id="DistrictId" />
                        <input asp-for="Ward" type="hidden" id="Ward" />
                        <input asp-for="WardCode" type="hidden" id="WardCode" />

                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="City" class="form-label text-uppercase small font-weight-bold">Tỉnh / Thành phố</label>
                                <select id="ghnProvince" class="form-control form-control-modern" required><option value="">Chọn tỉnh / thành phố</option></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="District" class="form-label text-uppercase small font-weight-bold">Quận / Huyện</label>
                                <select id="ghnDistrict" class="form-control form-control-modern" required disabled><option value="">Chọn quận / huyện</option></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Ward" class="form-label text-uppercase small font-weight-bold">Phường / Xã</label>
                                <select id="ghnWard" class="form-control form-control-modern" required disabled><option value="">Chọn phường / xã</option></select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Phương thức vận chuyển -->
                <div class="checkout-card" id="shippingMethodCard" style="display:none;" data-aos="fade-up">
                    <div class="checkout-card-header">
                        <i class="fas fa-shipping-fast"></i> Phương Thức Vận Chuyển
                    </div>
                    <div id="shippingOptionsContainer"></div>
                </div>

                <!-- Sản phẩm thanh toán -->
                <div class="checkout-card" data-aos="fade-up" data-aos-delay="50">
                    <div class="checkout-card-header">
                        <i class="fas fa-box-open"></i> Sản Phẩm Đặt Mua
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0" style="font-size: 0.95rem;">
                            <thead>
                                <tr class="text-muted text-uppercase" style="border-top: none; font-size: 0.8rem; letter-spacing: 1px;">
                                    <th class="pl-0">Sản phẩm</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-right pr-0">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (cartItems.Any())
                                {
                                    foreach (var item in cartItems)
                                    {
                                        var prod = item.ProductVariant?.Product;
                                        <tr>
                                            <td class="pl-0 py-3">
                                                <div class="font-weight-bold" style="font-family: var(--font-heading); font-size: 1.05rem;">@prod?.ProductName</div>
                                                <small class="text-muted">Phân loại: @item.ProductVariant?.Color?.ColorName - Size @item.ProductVariant?.Size?.SizeName</small>
                                            </td>
                                            <td class="text-center align-middle">@((prod?.CurrentPrice ?? 0m).ToString("N0"))₫</td>
                                            <td class="text-center align-middle font-weight-bold">@item.Quantity</td>
                                            <td class="text-right pr-0 align-middle font-weight-bold" style="color: var(--color-gold);">
                                                @(((prod?.CurrentPrice ?? 0m) * item.Quantity).ToString("N0"))₫
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="checkout-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="checkout-card-header">
                        <i class="fas fa-credit-card"></i> Phương Thức Thanh Toán
                    </div>

                    <div class="option-card payment-option-card selected" onclick="selectPayment('pm-cod')">
                        <input type="radio" name="paymentMethodId" id="pmCOD" value="pm-cod" checked style="display:none;" />
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <div class="d-flex align-items-center gap-3">
                                <div style="font-size: 1.5rem; color: var(--color-gold);"><i class="fas fa-money-bill-wave"></i></div>
                                <div>
                                    <div class="font-weight-bold text-uppercase" style="font-size: 0.9rem; letter-spacing: 0.5px;">Thanh toán khi nhận hàng (COD)</div>
                                    <small class="text-muted">Thanh toán bằng tiền mặt trực tiếp cho shipper khi nhận hàng.</small>
                                </div>
                            </div>
                            <div class="check-icon" style="color: var(--color-blue);"><i class="fas fa-check-circle"></i></div>
                        </div>
                    </div>

                    <div class="option-card payment-option-card" onclick="selectPayment('pm-vnpay')">
                        <input type="radio" name="paymentMethodId" id="pmVNPay" value="pm-vnpay" style="display:none;" />
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <div class="d-flex align-items-center gap-3">
                                <div style="font-size: 1.5rem; color: #0284c7;"><i class="fas fa-qrcode"></i></div>
                                <div>
                                    <div class="font-weight-bold text-uppercase" style="font-size: 0.9rem; letter-spacing: 0.5px;">Thanh toán qua VNPAY</div>
                                    <small class="text-muted">Quét mã QR, Thẻ ATM nội địa hoặc Ví điện tử.</small>
                                </div>
                            </div>
                            <div class="check-icon text-muted" style="display:none;"><i class="fas fa-check-circle"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Sidebar -->
            <div class="col-lg-4">
                <div class="summary-section" data-aos="fade-left">
                    <h5 class="font-weight-bold text-uppercase mb-4 pb-3 border-bottom" style="font-family: var(--font-heading); letter-spacing: 1px;">
                        Chi Tiết Thanh Toán
                    </h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tổng tiền hàng</span>
                        <span class="font-weight-bold">@(total.ToString("N0")) đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Phí vận chuyển</span>
                        <span class="font-weight-bold" id="shippingFeeVal">@(shippingFee.ToString("N0")) đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Giảm giá voucher</span>
                        <span class="font-weight-bold" id="discountVal" style="color: var(--color-blue);">- 0 đ</span>
                    </div>

                    <!-- Input Voucher (Đã cập nhật CSS Button) -->
                    <div class="mb-4 mt-4 p-3" style="background: #faf9f6; border: 1px solid var(--color-border);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label font-weight-bold text-uppercase mb-0" style="font-size: 0.75rem; letter-spacing: 1px;">Mã Khuyến Mãi</label>
                            <a href="javascript:void(0)" class="font-weight-bold" id="btnOpenVoucherModal" style="font-size: 0.8rem; color: var(--color-blue); text-decoration: none;">
                                <i class="fas fa-ticket-alt mr-1"></i>Kho Voucher
                            </a>
                        </div>
                        <div class="input-group">
                            <input type="text" id="voucherCodeInput" class="form-control form-control-modern" placeholder="MÃ GIẢM GIÁ" style="text-transform: uppercase; font-weight: bold" />
                            <div class="input-group-append" style="padding-left: 10px;">
                                <button class="btn-luxury-primary" style="padding: 10px 20px;" type="button" id="btnApplyVoucher">ÁP DỤNG</button>
                            </div>
                        </div>
                        <div id="voucherMessage" class="mt-2" style="font-size: 0.8rem; font-weight: 600;"></div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="font-weight-bold text-uppercase">Tổng thanh toán</span>
                        <span class="font-weight-bold" id="finalPayVal" style="color: var(--color-gold); font-size: 1.6rem; font-family: var(--font-heading);">
                            @((total + shippingFee).ToString("N0")) đ
                        </span>
                    </div>

                    <button type="submit" class="btn-luxury-primary">
                        ĐẶT HÀNG NGAY
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="fas fa-shield-alt mr-1" style="color: var(--color-gold);"></i>Bảo mật thông tin thanh toán 100%.</small>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal Kho Voucher -->
<div class="modal fade" id="voucherModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 0;">
            <div class="modal-header" style="background: var(--color-primary); color: white; padding: 15px 20px; border: none;">
                <h5 class="modal-title font-weight-bold text-uppercase text-white" style="font-family: var(--font-heading); letter-spacing: 1px;">
                    <i class="fas fa-wallet mr-2" style="color: var(--color-gold);"></i>Kho Voucher Khả Dụng
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="outline: none;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="background-color: #faf9f6; max-height: 420px; overflow-y: auto; padding: 20px;">
                <div id="voucherModalLoading" class="text-center py-4">
                    <div class="spinner-border" style="color: var(--color-gold);" role="status"></div>
                    <p class="text-muted mt-2 mb-0 font-weight-bold" style="font-size: 0.85rem;">Đang tìm kiếm ưu đãi dành cho bạn...</p>
                </div>
                <div id="voucherListContainer"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        $(document).ready(function () {
            AOS.init({ once: true, offset: 50, duration: 800 });
        });

        function selectPayment(val) {
            // Uncheck all
            document.getElementById('pmCOD').checked = false;
            document.getElementById('pmVNPay').checked = false;

            // Check target
            if (val === 'pm-cod') {
                document.getElementById('pmCOD').checked = true;
            } else {
                document.getElementById('pmVNPay').checked = true;
            }

            // Toggle selected classes
            var cards = document.querySelectorAll('.payment-option-card');
            cards.forEach(function (card, idx) {
                var input = card.querySelector('input');
                var checkIcon = card.querySelector('.check-icon');
                if (input.checked) {
                    card.classList.add('selected');
                    checkIcon.style.display = 'block';
                    checkIcon.classList.remove('text-muted');
                    checkIcon.style.color = 'var(--color-blue)';
                } else {
                    card.classList.remove('selected');
                    checkIcon.style.display = 'none';
                }
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // =========================================================================
            // 1. QUẢN LÝ TRẠNG THÁI SỐ LIỆU ĐƠN HÀNG (STATE MANAGEMENT)
            // =========================================================================
            var orderState = {
                orderTotal: parseFloat(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(total))) || 0,
                shippingFee: parseFloat(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(shippingFee))) || 0,
                discount: 0,
                buyNowVariantId: "@(ViewBag.BuyNowVariantId ?? "")",
                buyNowQty: parseInt("@(ViewBag.BuyNowQty ?? 1)") || 1
            };

            function updateTotalsUI() {
                var finalAmount = orderState.orderTotal - orderState.discount + orderState.shippingFee;
                if (finalAmount < 0) finalAmount = 0;

                document.getElementById("shippingFeeVal").innerText = orderState.shippingFee.toLocaleString("vi-VN") + " đ";
                document.getElementById("discountVal").innerText = "- " + orderState.discount.toLocaleString("vi-VN") + " đ";
                document.getElementById("finalPayVal").innerText = finalAmount.toLocaleString("vi-VN") + " đ";

                document.getElementById("shippingFeeInput").value = orderState.shippingFee;
            }

            // =========================================================================
            // 2. XỬ LÝ ÁP DỤNG VOUCHER
            // =========================================================================
            var btnApply = document.getElementById("btnApplyVoucher");
            var voucherInput = document.getElementById("voucherCodeInput");
            var msgDiv = document.getElementById("voucherMessage");
            var hiddenInput = document.getElementById("appliedPromoCode");

            var btnOpenModal = document.getElementById("btnOpenVoucherModal");
            var voucherModal = $("#voucherModal");
            var voucherContainer = document.getElementById("voucherListContainer");
            var loadingSpinner = document.getElementById("voucherModalLoading");

            function processVoucher(code) {
                if (!code) {
                    msgDiv.innerHTML = "<span class='text-danger'><i class='fas fa-exclamation-circle mr-1'></i>Vui lòng nhập mã giảm giá.</span>";
                    return;
                }

                msgDiv.innerHTML = "<span class='text-info'><i class='fas fa-spinner fa-spin mr-1'></i>Đang áp dụng...</span>";

                $.ajax({
                    url: "/Order/ApplyVoucher",
                    type: "POST",
                    data: {
                        promoCode: code,
                        orderTotal: orderState.orderTotal,
                        buyNowVariantId: orderState.buyNowVariantId,
                        buyNowQty: orderState.buyNowQty
                    },
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (res) {
                        if (res.success) {
                            msgDiv.innerHTML = "<span class='text-success'><i class='fas fa-check-circle mr-1'></i>" + res.message + "</span>";
                            hiddenInput.value = code;
                            orderState.discount = res.discount;
                        } else {
                            msgDiv.innerHTML = "<span class='text-danger'><i class='fas fa-exclamation-circle mr-1'></i>" + res.message + "</span>";
                            hiddenInput.value = "";
                            orderState.discount = 0;
                        }
                        updateTotalsUI(); // Tự động cập nhật UI tổng tiền
                    },
                    error: function () {
                        msgDiv.innerHTML = "<span class='text-danger'><i class='fas fa-times-circle mr-1'></i>Có lỗi xảy ra khi áp dụng mã giảm giá.</span>";
                        hiddenInput.value = "";
                        orderState.discount = 0;
                        updateTotalsUI();
                    }
                });
            }

            btnOpenModal.addEventListener("click", function () {
                loadingSpinner.style.display = "block";
                voucherContainer.innerHTML = "";
                voucherModal.modal("show");

                $.ajax({
                    url: "/Order/GetAvailableVouchers",
                    type: "GET",
                    data: {
                        orderTotal: orderState.orderTotal,
                        buyNowVariantId: orderState.buyNowVariantId,
                        buyNowQty: orderState.buyNowQty
                    },
                    success: function (vouchers) {
                        loadingSpinner.style.display = "none";
                        if (!vouchers || vouchers.length === 0) {
                            voucherContainer.innerHTML = "<div class='text-center py-4 text-muted font-weight-bold'><i class='fas fa-info-circle mr-1'></i>Hiện không có chương trình khuyến mãi nào khả dụng.</div>";
                            return;
                        }

                        var html = "";
                        vouchers.forEach(function (v) {
                            var statusClass = v.isApplicable ? "" : "disabled";
                            var disabledAttr = v.isApplicable ? "" : "disabled";
                            var icon = v.discountType === "Percent" ? "fa-percentage" : "fa-money-bill-wave";
                            var statusBadge = "";

                            if (v.isApplicable) {
                                statusBadge = "<span class='badge text-white font-weight-bold mb-1' style='background: #10b981; border-radius: 0;'>Đủ điều kiện</span>";
                            } else {
                                if (v.message.indexOf("Mua thêm") !== -1) {
                                    statusBadge = "<span class='badge text-dark font-weight-bold mb-1' style='background: #f59e0b; border-radius: 0;'>" + v.message + "</span>";
                                } else {
                                    statusBadge = "<span class='badge text-white font-weight-bold mb-1' style='background: #ef4444; border-radius: 0;'>" + v.message + "</span>";
                                }
                            }

                            html += "<div class='voucher-ticket " + statusClass + "'>" +
                                "  <div class='voucher-left'>" +
                                "    <i class='fas " + icon + "'></i>" +
                                "    <span class='promo-badge' title='" + v.promoCode + "'>" + v.promoCode + "</span>" +
                                "  </div>" +
                                "  <div class='voucher-right'>" +
                                "    <div>" +
                                "      <div class='voucher-title'>" + v.description + "</div>" +
                                "      <div class='voucher-subtitle'>" + statusBadge + "</div>" +
                                "    </div>" +
                                "    <div class='voucher-footer'>" +
                                "      <div class='voucher-expiry'><i class='far fa-clock mr-1'></i>Hạn: " + v.endDateFormatted + "</div>" +
                                "      <button type='button' class='btn-luxury-outline btn-apply-click' data-code='" + v.promoCode + "' " + disabledAttr + " style='padding: 4px 10px; font-size:0.75rem;'>Áp dụng</button>" +
                                "    </div>" +
                                "  </div>" +
                                "</div>";
                        });

                        voucherContainer.innerHTML = html;
                    },
                    error: function () {
                        loadingSpinner.style.display = "none";
                        voucherContainer.innerHTML = "<div class='text-center py-4 text-danger font-weight-bold'><i class='fas fa-exclamation-circle mr-1'></i>Không thể tải danh sách voucher.</div>";
                    }
                });
            });

            btnApply.addEventListener("click", function () {
                var code = voucherInput.value.trim();
                processVoucher(code);
            });

            // Gắn event delegation cho các nút "Áp dụng" động sinh ra trong Modal
            $(document).on('click', '.btn-apply-click', function (e) {
                e.preventDefault();
                var code = $(this).attr("data-code");
                $("#voucherCodeInput").val(code);
                $("#voucherModal").modal("hide");
                processVoucher(code);
            });

            // =========================================================================
            // 3. LOGIC GỢI Ý ĐỊA CHỈ GEOAPIFY VÀ GHN SHIPPING
            // =========================================================================
            function showAddressError(message) {
                $('#shippingMethodCard').show();
                $('#shippingOptionsContainer').html("<div class='text-center py-4 text-danger font-weight-bold'><i class='fas fa-exclamation-circle mr-1'></i>" + message + "</div>");
            }

            var addressInput = document.getElementById('SpecificAddress');
            var addressSuggestions = document.getElementById('addressSuggestions');
            var addressSuggestionHelp = document.getElementById('addressSuggestionHelp');
            var addressSuggestionTimer = null;
            var addressSuggestionRequest = null;

            function closeAddressSuggestions() {
                addressSuggestions.hidden = true;
                addressSuggestions.replaceChildren();
            }

            function resetAddressSuggestionState() {
                closeAddressSuggestions();
                addressSuggestionHelp.className = 'form-text text-muted';
                addressSuggestionHelp.textContent = 'Nhập ít nhất 3 ký tự để nhận gợi ý đúng khu vực đã chọn.';
            }

            addressInput.addEventListener('input', function () {
                clearTimeout(addressSuggestionTimer);
                closeAddressSuggestions();
                addressSuggestionHelp.className = 'form-text text-muted';

                var query = addressInput.value.trim();
                var ward = $('#Ward').val();
                var district = $('#District').val();
                var province = $('#City').val();

                if (!ward || !district || !province) {
                    addressSuggestionHelp.textContent = 'Vui lòng chọn tỉnh, quận và phường trước khi tìm tên đường.';
                    return;
                }
                if (query.length < 3) {
                    addressSuggestionHelp.textContent = 'Nhập cả số nhà và tên đường để nhận gợi ý chính xác hơn.';
                    return;
                }

                addressSuggestionHelp.textContent = 'Đang tìm địa chỉ phù hợp...';
                addressSuggestionTimer = setTimeout(async function () {
                    if (addressSuggestionRequest) addressSuggestionRequest.abort();
                    addressSuggestionRequest = new AbortController();

                    var url = new URL('/Order/SuggestAddresses', window.location.origin);
                    url.searchParams.set('query', query);
                    url.searchParams.set('ward', ward);
                    url.searchParams.set('district', district);
                    url.searchParams.set('province', province);

                    try {
                        var response = await fetch(url, { signal: addressSuggestionRequest.signal });
                        var result = await response.json();
                        closeAddressSuggestions();

                        if (!result.configured) {
                            addressSuggestionHelp.textContent = 'Bạn vẫn có thể nhập địa chỉ thủ công.';
                            return;
                        }
                        if (!result.success || !result.data || result.data.length === 0) {
                            addressSuggestionHelp.textContent = 'Không tìm thấy gợi ý phù hợp; hãy kiểm tra lại số nhà và tên đường.';
                            return;
                        }

                        result.data.forEach(function (suggestion) {
                            var button = document.createElement('button');
                            button.type = 'button';
                            button.className = 'address-suggestion-item';
                            button.setAttribute('role', 'option');
                            button.textContent = suggestion.label;
                            button.addEventListener('click', function () {
                                addressInput.value = suggestion.value;
                                closeAddressSuggestions();
                                addressSuggestionHelp.className = 'form-text text-success font-weight-bold';
                                addressSuggestionHelp.textContent = 'Đã chọn địa chỉ từ gợi ý Geoapify.';
                            });
                            addressSuggestions.appendChild(button);
                        });

                        var attribution = document.createElement('div');
                        attribution.className = 'px-3 py-1 text-right text-muted small';
                        attribution.textContent = 'powered by Geoapify';
                        addressSuggestions.appendChild(attribution);
                        addressSuggestions.hidden = false;
                        addressSuggestionHelp.textContent = 'Chọn một địa chỉ phù hợp trong danh sách.';
                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            addressSuggestionHelp.textContent = 'Không thể tải gợi ý lúc này; bạn vẫn có thể nhập thủ công.';
                        }
                    }
                }, 450);
            });

            document.addEventListener('click', function (event) {
                if (!event.target.closest('.address-autocomplete')) closeAddressSuggestions();
            });

            function loadProvinces() {
                $.get('/Order/GetProvinces').done(function (res) {
                    if (!res.success) { showAddressError(res.message); return; }
                    var options = '<option value="">Chọn tỉnh / thành phố</option>';
                    res.data.forEach(function (p) { options += '<option value="' + p.provinceId + '">' + p.provinceName + '</option>'; });
                    $('#ghnProvince').html(options);
                }).fail(function () { showAddressError('Không thể tải địa chỉ từ GHN.'); });
            }

            $('#ghnProvince').on('change', function () {
                resetAddressSuggestionState();
                var option = this.options[this.selectedIndex];
                $('#ProvinceId').val(this.value || 0);
                $('#City').val(option && this.value ? option.text : '');
                $('#DistrictId').val(0); $('#District').val(''); $('#WardCode').val(''); $('#Ward').val('');
                $('#ghnDistrict').prop('disabled', true).html('<option value="">Đang tải...</option>');
                $('#ghnWard').prop('disabled', true).html('<option value="">Chọn phường / xã</option>');
                $('#shippingMethodCard').hide();
                if (!this.value) return;

                $.get('/Order/GetDistricts', { provinceId: this.value }).done(function (res) {
                    if (!res.success) { showAddressError(res.message); return; }
                    var options = '<option value="">Chọn quận / huyện</option>';
                    res.data.forEach(function (d) { options += '<option value="' + d.districtId + '">' + d.districtName + '</option>'; });
                    $('#ghnDistrict').html(options).prop('disabled', false);
                }).fail(function () { showAddressError('Không thể tải quận/huyện từ GHN.'); });
            });

            $('#ghnDistrict').on('change', function () {
                resetAddressSuggestionState();
                var option = this.options[this.selectedIndex];
                $('#DistrictId').val(this.value || 0);
                $('#District').val(option && this.value ? option.text : '');
                $('#WardCode').val(''); $('#Ward').val('');
                $('#ghnWard').prop('disabled', true).html('<option value="">Đang tải...</option>');
                $('#shippingMethodCard').hide();
                if (!this.value) return;

                $.get('/Order/GetWards', { districtId: this.value }).done(function (res) {
                    if (!res.success) { showAddressError(res.message); return; }
                    var options = '<option value="">Chọn phường / xã</option>';
                    res.data.forEach(function (w) { options += '<option value="' + w.wardCode + '">' + w.wardName + '</option>'; });
                    $('#ghnWard').html(options).prop('disabled', false);
                }).fail(function () { showAddressError('Không thể tải phường/xã từ GHN.'); });
            });

            $('#ghnWard').on('change', function () {
                resetAddressSuggestionState();
                var option = this.options[this.selectedIndex];
                $('#WardCode').val(this.value || '');
                $('#Ward').val(option && this.value ? option.text : '');
                loadShippingRates();
            });

            window.loadShippingRates = function () {
                var districtId = parseInt($('#DistrictId').val()) || 0;
                var wardCode = $('#WardCode').val();
                if (!districtId || !wardCode) {
                    $('#shippingMethodCard').hide();
                    return;
                }

                $('#shippingMethodCard').show();
                $('#shippingOptionsContainer').html(
                    '<div class="text-center py-4">' +
                    '  <div class="spinner-border" style="color: var(--color-blue);" role="status">' +
                    '    <span class="sr-only">Đang tính phí ship...</span>' +
                    '  </div>' +
                    '  <p class="text-muted mt-2 mb-0 font-weight-bold" style="font-size: 0.9rem;">Đang lấy phí và thời gian giao từ GHN...</p>' +
                    '</div>'
                );

                $.ajax({
                    url: "/Order/GetShippingFee",
                    type: "POST",
                    data: {
                        districtId: districtId,
                        wardCode: wardCode,
                        buyNowVariantId: orderState.buyNowVariantId,
                        buyNowQty: orderState.buyNowQty
                    },
                    success: function (res) {
                        if (res.success && res.quotes && res.quotes.length > 0) {
                            var html = "";
                            res.quotes.forEach(function (q) {
                                var eta = q.expectedDeliveryTime || 'GHN cập nhật sau';
                                html += '<div class="option-card shipping-option-card" onclick="selectShippingOption(this)" data-service-id="' + q.serviceId + '" data-service-type-id="' + q.serviceTypeId + '" data-fee="' + q.shippingFee + '">' +
                                    '  <div class="d-flex align-items-center justify-content-between w-100">' +
                                    '    <div class="d-flex align-items-center gap-3">' +
                                    '      <div style="font-size: 1.8rem; color: var(--color-blue);"><i class="fas fa-shipping-fast"></i></div>' +
                                    '      <div>' +
                                    '        <div class="font-weight-bold text-dark text-uppercase" style="font-size: 0.95rem;">' + q.serviceName + '</div>' +
                                    '        <small class="text-muted"><i class="far fa-clock mr-1"></i>Dự kiến: ' + eta + '</small>' +
                                    '      </div>' +
                                    '    </div>' +
                                    '    <div class="font-weight-bold" style="color: var(--color-gold); font-size: 1.1rem;">' + q.shippingFee.toLocaleString("vi-VN") + ' đ</div>' +
                                    '  </div>' +
                                    '</div>';
                            });

                            $('#shippingOptionsContainer').html(html);

                            // Chọn mặc định tùy chọn vận chuyển đầu tiên
                            var firstCard = $('#shippingOptionsContainer .shipping-option-card').first();
                            if (firstCard.length) {
                                selectShippingOption(firstCard[0]);
                            }
                        } else {
                            var message = res.message || 'Không thể tải danh sách dịch vụ vận chuyển.';
                            var errorBox = $('<div class="text-center py-4 text-danger font-weight-bold"></div>').text(message);
                            errorBox.prepend('<i class="fas fa-exclamation-circle mr-1"></i>');
                            $('#shippingOptionsContainer').empty().append(errorBox);
                        }
                    },
                    error: function (xhr) {
                        var message = xhr.responseJSON && xhr.responseJSON.message
                            ? xhr.responseJSON.message
                            : 'Không thể kết nối dịch vụ vận chuyển.';
                        var errorBox = $('<div class="text-center py-4 text-danger font-weight-bold"></div>').text(message);
                        errorBox.prepend('<i class="fas fa-exclamation-circle mr-1"></i>');
                        $('#shippingOptionsContainer').empty().append(errorBox);
                    }
                });
            };

            window.selectShippingOption = function (el) {
                $('.shipping-option-card').removeClass('selected');
                $(el).addClass('selected');

                // Cập nhật phí ship vào State Object
                orderState.shippingFee = parseFloat($(el).attr('data-fee')) || 0;

                $('#shippingServiceId').val($(el).attr('data-service-id'));
                $('#shippingServiceTypeId').val($(el).attr('data-service-type-id'));

                // Cập nhật UI tính tổng
                updateTotalsUI();
            };

            loadProvinces();
        });
    </script>
}