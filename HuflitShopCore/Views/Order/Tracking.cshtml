@model dynamic
@{
    Layout = "_Layout";
    ViewData["Title"] = "Theo dõi vận đơn hỏa tốc";

    string trackingNumber = ViewBag.TrackingNumber ?? "";
    string driverName = ViewBag.DriverName ?? "Nguyễn Văn Hùng";
    string driverPhone = ViewBag.DriverPhone ?? "0903829103";
    string licensePlate = ViewBag.LicensePlate ?? "59-K1 829.12";
    string address = ViewBag.Address ?? "";
    string district = ViewBag.District ?? "";
    string city = ViewBag.City ?? "";
    string carrierName = ViewBag.CarrierName ?? "GrabExpress";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
    :root {
        --font-heading: 'Playfair Display', serif;
        --font-body: 'Jost', sans-serif;
        --color-primary: #1c1c1c;
        --color-gold: #c5a059;
        --color-bg: #faf9f6;
        --color-blue: #0033ff;
        --color-border: #e2e8f0;
        --transition-slow: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    body {
        font-family: var(--font-body);
        background-color: var(--color-bg);
        color: var(--color-primary);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
    }

    .tracking-container {
        max-width: 1000px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
    }

    .tracking-card {
        background: #ffffff;
        border: 1px solid var(--color-border);
        box-shadow: 0 5px 20px rgba(0,0,0,0.02);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    #map {
        height: 480px;
        width: 100%;
        background-color: #f8fafc;
        z-index: 10;
    }

    .driver-card {
        background: #ffffff;
        border: 1px solid var(--color-border);
        padding: 1.75rem;
        margin-bottom: 1.5rem;
        border-top: 3px solid var(--color-gold);
    }

    .driver-avatar {
        width: 55px;
        height: 55px;
        background-color: var(--color-primary);
        color: var(--color-gold);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .status-badge-live {
        background-color: var(--color-primary);
        color: var(--color-gold);
        border: 1px solid var(--color-gold);
        padding: 6px 16px;
        font-size: 0.8rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        animation: pulse-glow-live 1.8s infinite;
    }

    @@keyframes pulse-glow-live {
        0% {
            box-shadow: 0 0 0 0 rgba(197, 160, 89, 0.4);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(197, 160, 89, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(197, 160, 89, 0);
        }
    }

    .btn-luxury-sm {
        display: block;
        width: 100%;
        padding: 12px;
        background: var(--color-primary);
        color: #fff;
        border: none;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.8rem;
        transition: var(--transition-slow);
        text-align: center;
        text-decoration: none !important;
    }

        .btn-luxury-sm:hover {
            background: var(--color-blue);
            color: #fff;
        }
</style>

<div class="tracking-container">
    <div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-up">
        <div>
            <h2 class="font-weight-bold mb-1" style="font-size: 2.2rem;">
                <i class="fas fa-shipping-fast mr-2" style="color: var(--color-gold);"></i>Giao Hàng Hỏa Tốc
            </h2>
            <p class="text-muted mb-0">Mã vận đơn: <span class="badge badge-dark" style="font-size: 0.85rem;">#@trackingNumber</span> &bull; Đơn vị: <strong>@carrierName</strong></p>
        </div>
        <div class="status-badge-live" id="liveBadge">Đang giao hàng</div>
    </div>

    <!-- Map container -->
    <div class="tracking-card" data-aos="fade-up">
        <div id="map"></div>
    </div>

    <!-- Driver and destination profiles -->
    <div class="row">
        <div class="col-md-6 mb-3" data-aos="fade-right">
            <div class="driver-card h-100">
                <h5 class="font-weight-bold border-bottom pb-2 mb-3" style="font-family: var(--font-heading);"><i class="fas fa-motorcycle mr-2" style="color: var(--color-gold);"></i>Thông Tin Tài Xế</h5>
                <div class="d-flex align-items-center gap-3 mb-3" style="gap: 15px;">
                    <div class="driver-avatar">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div>
                        <div class="font-weight-bold" style="font-size: 1.1rem; font-family: var(--font-heading);">@driverName</div>
                        <div class="text-muted small">Biển số xe: <strong>@licensePlate</strong></div>
                        <div class="text-muted small">Phương tiện: Honda Wave Alpha</div>
                    </div>
                </div>
                <a href="tel:@driverPhone" class="btn-luxury-sm">
                    <i class="fas fa-phone-alt mr-2"></i>Liên hệ tài xế (@driverPhone)
                </a>
            </div>
        </div>

        <div class="col-md-6 mb-3" data-aos="fade-left">
            <div class="driver-card h-100">
                <h5 class="font-weight-bold border-bottom pb-2 mb-3" style="font-family: var(--font-heading);"><i class="fas fa-map-marker-alt mr-2" style="color: var(--color-gold);"></i>Điểm Giao Hàng</h5>
                <div style="line-height: 1.8; color: #555; font-size: 0.95rem;">
                    <div><strong>Khách hàng:</strong> @driverName</div>
                    <div><strong>Địa chỉ:</strong> @address</div>
                    <div><strong>Khu vực:</strong> @district, @city</div>
                    <div class="mt-2 text-muted small"><i class="fas fa-info-circle mr-1"></i>Kho gửi: 828 Sư Vạn Hạnh, Quận 10, TP.HCM</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        AOS.init({ once: true, offset: 50, duration: 800 });

        var shopCoords = [10.776686, 106.667793];
        var district = "@district";
        var destCoords = [10.773, 106.662];

        if (district.indexOf("Quận 1") !== -1 && district.indexOf("Quận 10") === -1) { destCoords = [10.782, 106.696]; }
        else if (district.indexOf("Quận 3") !== -1) { destCoords = [10.780, 106.681]; }
        else if (district.indexOf("Tân Bình") !== -1) { destCoords = [10.795, 106.654]; }

        var centerLat = (shopCoords[0] + destCoords[0]) / 2;
        var centerLng = (shopCoords[1] + destCoords[1]) / 2;

        var map = L.map('map').setView([centerLat, centerLng], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var storeIcon = L.icon({ iconUrl: 'https://cdn-icons-png.flaticon.com/512/869/869636.png', iconSize: [34, 34] });
        var homeIcon = L.icon({ iconUrl: 'https://cdn-icons-png.flaticon.com/512/1216/1216844.png', iconSize: [34, 34] });
        var driverIcon = L.icon({ iconUrl: 'https://cdn-icons-png.flaticon.com/512/2965/2965319.png', iconSize: [38, 38] });

        L.marker(shopCoords, { icon: storeIcon }).addTo(map).bindPopup("Kho hàng HuflitShop (Q10)").openPopup();
        L.marker(destCoords, { icon: homeIcon }).addTo(map).bindPopup("Địa chỉ nhận hàng");

        var driverMarker = L.marker(shopCoords, { icon: driverIcon }).addTo(map);

        L.polyline([shopCoords, destCoords], { color: '#c5a059', weight: 4, opacity: 0.8, dashArray: '6, 6' }).addTo(map);

        var duration = 20000;
        var startTimestamp = null;
        var liveBadge = document.getElementById("liveBadge");

        function animationLoop(timestamp) {
            if (!startTimestamp) startTimestamp = timestamp;
            var elapsed = timestamp - startTimestamp;
            var t = Math.min(elapsed / duration, 1.0);

            var currentLat = shopCoords[0] + (destCoords[0] - shopCoords[0]) * t;
            var currentLng = shopCoords[1] + (destCoords[1] - shopCoords[1]) * t;

            driverMarker.setLatLng([currentLat, currentLng]);

            if (t >= 1.0) {
                driverMarker.bindPopup("<strong>Đã đến điểm giao!</strong>").openPopup();
                liveBadge.innerText = "Đã giao hàng";
                liveBadge.style.backgroundColor = "#10b981";
                liveBadge.style.color = "#ffffff";
                liveBadge.style.border = "none";
                liveBadge.style.animation = "none";
            } else {
                requestAnimationFrame(animationLoop);
            }
        }

        setTimeout(function () { requestAnimationFrame(animationLoop); }, 1000);
    });
</script>