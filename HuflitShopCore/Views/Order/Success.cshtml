@{
    Layout = "_Layout";
    ViewData["Title"] = ViewBag.PaymentSuccess == false ? "Đặt hàng thất bại" : "Đặt hàng thành công";

    string originalAddress = ViewBag.ShippingAddress as string ?? "";
    string cleanAddress = originalAddress;
    string carrier = "Tiêu chuẩn";
    string trackingNumber = "";
    string driverName = "";
    string driverPhone = "";
    string licensePlate = "";
    string trackingUrl = "";

    if (originalAddress.Contains(" | "))
    {
        var parts = originalAddress.Split('|');
        cleanAddress = parts[0].Trim();
        foreach (var part in parts)
        {
            var trimmed = part.Trim();
            if (trimmed.StartsWith("Vận chuyển:")) { carrier = trimmed.Replace("Vận chuyển:", "").Trim(); }
            else if (trimmed.StartsWith("Tracking:")) { trackingNumber = trimmed.Replace("Tracking:", "").Trim(); }
            else if (trimmed.StartsWith("Driver:"))
            {
                var driverInfo = trimmed.Replace("Driver:", "").Trim();
                var phoneIndex = driverInfo.IndexOf('(');
                var plateIndex = driverInfo.IndexOf(" - ");
                if (phoneIndex != -1 && plateIndex != -1)
                {
                    driverName = driverInfo.Substring(0, phoneIndex).Trim();
                    driverPhone = driverInfo.Substring(phoneIndex + 1, plateIndex - phoneIndex - 2).Trim();
                    licensePlate = driverInfo.Substring(plateIndex + 3).Trim();
                }
                else { driverName = driverInfo; }
            }
            else if (trimmed.StartsWith("Link:")) { trackingUrl = trimmed.Replace("Link:", "").Trim(); }
        }
    }
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet">

<style>
    :root {
        --font-heading: 'Playfair Display', serif;
        --font-body: 'Jost', sans-serif;
        --color-primary: #1c1c1c;
        --color-gold: #c5a059;
        --color-bg: #faf9f6;
        --color-blue: #0033ff;
        --color-border: #e2e8f0;
        --transition-slow: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    body {
        font-family: var(--font-body);
        background-color: var(--color-bg);
        color: var(--color-primary);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
    }

    .success-container {
        padding: 4rem 1rem;
        min-height: 75vh;
        display: flex;
        align-items: center;
    }

    /* Status Luxury Card */
    .status-card {
        background: #ffffff;
        border: 1px solid var(--color-border);
        padding: 3.5rem 2.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        border-top: 3px solid var(--color-gold);
    }

        .status-card.failed {
            border-top-color: #ef4444;
        }

    .icon-wrapper {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2.2rem;
        color: #fff;
    }

    .icon-success {
        background: var(--color-primary);
        color: var(--color-gold);
        border: 1px solid var(--color-gold);
    }

    .icon-failed {
        background: #ef4444;
    }

    .status-title {
        font-size: 2.2rem;
        font-weight: 600;
        color: var(--color-primary);
        margin-bottom: 0.75rem;
    }

    .status-desc {
        color: #666;
        font-size: 1rem;
        max-width: 520px;
        margin: 0 auto 2.5rem;
        line-height: 1.6;
    }

    /* Info Box */
    .order-info-box {
        background: #faf9f6;
        border: 1px solid var(--color-border);
        padding: 2rem;
        margin-bottom: 2.5rem;
        text-align: left;
    }

    .order-info-header {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--color-primary);
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .order-info-header i {
            color: var(--color-gold);
        }

    .info-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 0.3rem;
    }

    .info-value {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--color-primary);
    }

    .info-value-price {
        font-size: 1.5rem;
        font-weight: 600;
        font-family: var(--font-heading);
        color: var(--color-gold);
    }

    /* Luxury Buttons */
    .btn-luxury-sm {
        display: inline-block;
        padding: 12px 28px;
        background: var(--color-primary);
        color: #fff;
        border: none;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.8rem;
        transition: var(--transition-slow);
        text-decoration: none !important;
    }

        .btn-luxury-sm:hover {
            background: var(--color-blue);
            color: #fff;
        }

    .btn-luxury-outline-sm {
        display: inline-block;
        padding: 12px 28px;
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 0.8rem;
        transition: var(--transition-slow);
        text-decoration: none !important;
    }

        .btn-luxury-outline-sm:hover {
            background: var(--color-primary);
            color: #fff;
        }

    /* Live Grab/Ahamove Tracking Card */
    .express-tracking-card {
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-top: 3px solid var(--color-gold);
        padding: 1.75rem;
        margin: 2rem 0;
        text-align: left;
    }

    .express-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
    }

    .express-brand {
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--color-primary);
    }

    /* Delivery Progress Timeline */
    .delivery-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 1.5rem 0;
    }

        .delivery-timeline::before {
            content: '';
            position: absolute;
            top: 14px;
            left: 5%;
            width: 90%;
            height: 2px;
            background: var(--color-border);
            z-index: 1;
        }

    .timeline-progress-bar {
        position: absolute;
        top: 14px;
        left: 5%;
        width: 10%;
        height: 2px;
        background: var(--color-gold);
        z-index: 2;
        transition: width 1s linear;
    }

    .timeline-node {
        position: relative;
        z-index: 3;
        text-align: center;
        width: 20%;
    }

    .node-dot {
        width: 28px;
        height: 28px;
        background: #fff;
        border: 2px solid var(--color-border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        margin: 0 auto;
        transition: var(--transition-slow);
    }

    .timeline-node.active .node-dot, .timeline-node.passed .node-dot {
        border-color: var(--color-gold);
        background: var(--color-gold);
        color: #fff;
    }

    .node-label {
        margin-top: 0.4rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Map Road */
    .map-simulation-box {
        position: relative;
        height: 100px;
        background: #faf9f6;
        border: 1px solid var(--color-border);
        overflow: hidden;
        margin-top: 1rem;
    }

    .map-road {
        position: absolute;
        top: 50%;
        left: 5%;
        width: 90%;
        border-top: 2px dashed #bbb;
        transform: translateY(-50%);
    }

    .map-marker {
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 5;
    }

    .marker-driver {
        left: 5%;
        color: var(--color-gold);
        font-size: 1.6rem;
        transition: left 1s linear;
    }
</style>

<div class="success-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 text-center" data-aos="fade-up">

                @if (ViewBag.PaymentSuccess == false)
                {
                    <div class="status-card failed">
                        <div class="icon-wrapper icon-failed">
                            <i class="fas fa-times"></i>
                        </div>
                        <h2 class="status-title" style="color: #ef4444;">Thanh Toán Thất Bại</h2>
                        <p class="status-desc">
                            Giao dịch qua VNPAY không thành công hoặc đã bị hủy. Đơn hàng đã được tự động hủy trên hệ thống. Bạn vui lòng kiểm tra lại hoặc thử phương thức thanh toán khác.
                        </p>

                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a asp-controller="Home" asp-action="Index" class="btn-luxury-outline-sm">Về trang chủ</a>
                            <a asp-controller="Product" asp-action="Product" class="btn-luxury-sm">Tiếp tục mua sắm</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="status-card">
                        <div class="icon-wrapper icon-success">
                            <i class="fas fa-check"></i>
                        </div>
                        <h2 class="status-title">Đặt Hàng Thành Công</h2>
                        <p class="status-desc">
                            @if (ViewBag.PaymentSuccess == true)
                            {
                                <text>Cảm ơn bạn đã hoàn tất thanh toán VNPAY. Huflit Shop đang đóng gói sản phẩm và chuẩn bị bàn giao vận chuyển.</text>
                            }
                            else
                            {
                                <text>Cảm ơn bạn đã tin tưởng Huflit Shop! Đơn hàng thanh toán khi nhận hàng (COD) đã được tiếp nhận và sẽ sớm giao đến bạn.</text>
                            }
                        </p>

                        @if (carrier.Contains("GrabExpress", StringComparison.OrdinalIgnoreCase) || carrier.Contains("Ahamove", StringComparison.OrdinalIgnoreCase))
                        {
                            bool isAha = carrier.Contains("Ahamove", StringComparison.OrdinalIgnoreCase);
                            string brandNameText = isAha ? "Ahamove Hỏa Tốc" : "GrabExpress Hỏa Tốc";

                            <div class="express-tracking-card" data-aos="fade-up">
                                <div class="express-header">
                                    <div class="express-brand"><i class="fas fa-shipping-fast mr-2" style="color: var(--color-gold);"></i>@brandNameText</div>
                                    <div class="small font-weight-bold" id="statusLabel">Đang tìm tài xế...</div>
                                </div>

                                <div class="d-flex align-items-center justify-content-between p-3 mb-3" style="background: #faf9f6; border: 1px solid var(--color-border);">
                                    <div>
                                        <div class="font-weight-bold" style="font-size: 1rem;">@driverName</div>
                                        <small class="text-muted">Biển số: <strong>@licensePlate</strong> &bull; Mã VD: <strong>@trackingNumber</strong></small>
                                    </div>
                                    <a href="tel:@driverPhone" class="btn-luxury-outline-sm py-2 px-3" title="Gọi tài xế"><i class="fas fa-phone-alt"></i></a>
                                </div>

                                <div class="delivery-timeline">
                                    <div class="timeline-progress-bar" id="progressBar"></div>
                                    <div class="timeline-node active"><div class="node-dot">1</div><div class="node-label">Tìm xe</div></div>
                                    <div class="timeline-node"><div class="node-dot">2</div><div class="node-label">Lấy hàng</div></div>
                                    <div class="timeline-node"><div class="node-dot">3</div><div class="node-label">Đang giao</div></div>
                                    <div class="timeline-node"><div class="node-dot">4</div><div class="node-label">Đã giao</div></div>
                                </div>

                                <div class="map-simulation-box">
                                    <div class="map-road"></div>
                                    <div class="map-marker" style="left: 5%; color: var(--color-primary);"><i class="fas fa-store"></i></div>
                                    <div class="map-marker" style="right: 5%; color: #ef4444;"><i class="fas fa-home"></i></div>
                                    <div class="map-marker marker-driver" id="driverMarker"><i class="fas fa-motorcycle"></i></div>
                                </div>
                            </div>
                        }

                        <div class="order-info-box" data-aos="fade-up">
                            <div class="order-info-header">
                                <i class="fas fa-receipt"></i> Thông Tin Đơn Hàng
                            </div>
                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <div class="info-label">Mã đơn hàng</div>
                                    <div class="info-value">#@ViewBag.OrderId</div>
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <div class="info-label">Phương thức thanh toán</div>
                                    <div class="info-value">@ViewBag.PaymentMethodName</div>
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <div class="info-label">Tổng thanh toán</div>
                                    <div class="info-value-price">@String.Format("{0:0,0}₫", (decimal)ViewBag.FinalAmount)</div>
                                </div>
                                <div class="col-sm-6 mb-3">
                                    <div class="info-label">Địa chỉ giao hàng</div>
                                    <div class="info-value">
                                        @cleanAddress<br>
                                        @ViewBag.ShippingWard, @ViewBag.ShippingDistrict, @ViewBag.ShippingCity
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a asp-controller="Profile" asp-action="Index" class="btn-luxury-outline-sm">Đơn hàng của tôi</a>
                            <a asp-controller="Product" asp-action="Product" class="btn-luxury-sm">Tiếp tục mua sắm</a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        $(document).ready(function () {
            AOS.init({ once: true, offset: 50, duration: 800 });
        });
    </script>

    @if (carrier.Contains("GrabExpress", StringComparison.OrdinalIgnoreCase) || carrier.Contains("Ahamove", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var driverMarker = document.getElementById("driverMarker");
                var progressBar = document.getElementById("progressBar");
                var statusLabel = document.getElementById("statusLabel");
                var timelineNodes = document.querySelectorAll(".timeline-node");

                if (driverMarker) {
                    var steps = [
                        { left: 5, progress: 0, status: "Tài xế đang chuẩn bị nhận hàng...", activeNode: 0 },
                        { left: 35, progress: 30, status: "Tài xế đang lấy sản phẩm tại kho...", activeNode: 1 },
                        { left: 65, progress: 60, status: "Tài xế đang trên đường hỏa tốc giao hàng...", activeNode: 2 },
                        { left: 95, progress: 100, status: "Giao hàng thành công! Cảm ơn bạn.", activeNode: 3 }
                    ];

                    var currentStep = 0;
                    function animateStep() {
                        if (currentStep >= steps.length) return;
                        var stepData = steps[currentStep];

                        driverMarker.style.left = stepData.left + "%";
                        progressBar.style.width = stepData.progress + "%";
                        statusLabel.innerText = stepData.status;

                        timelineNodes.forEach(function (node, index) {
                            node.classList.remove("active");
                            if (index < stepData.activeNode) node.classList.add("passed");
                            else if (index === stepData.activeNode) { node.classList.add("active"); node.classList.remove("passed"); }
                        });

                        currentStep++;
                        setTimeout(animateStep, 3500);
                    }
                    setTimeout(animateStep, 1000);
                }
            });
        </script>
    }
}